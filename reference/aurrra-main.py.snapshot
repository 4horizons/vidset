            mode=request.mode,
            topic=request.topic,
            context=request.additional_context or "",
            duration=request.target_duration,
            research=request.research_report,
            vault_items=request.vault_items,
            selected_hook_formula=request.selected_hook_formula,
            brand_voice=request.brand_voice,
            content_classification=request.content_classification,
            niche=request.niche,
            website_url=request.website_url,
            script_angle=request.script_angle,
            output_language=request.output_language or "en",
            include_title=request.include_title,
        )
        return result
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


