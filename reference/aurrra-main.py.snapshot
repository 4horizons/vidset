@app.post("/youtube-research")
async def youtube_research_endpoint(request: YouTubeResearchRequest, _: bool = Depends(verify_api_key)):
    """Run YouTube outlier research via TubeLab.
    
    Supports two search types:
    - 'outliers': Search for viral videos by keywords (default)
    - 'channel': Fetch videos from a specific channel
    """
    try:
        search_type = request.search_type or "outliers"
        
        # Channel search mode
        if search_type == "channel" and request.channel_handle:
            print(f"Channel search for: {request.channel_handle}")
            content_type = request.content_type or "video"
            
            # First get channel info with embedded videos from search
            channels = search_youtube_channels(request.channel_handle, 1)
            if not channels:
                return {"results": [], "error": f"Could not find channel: {request.channel_handle}"}
            
            channel = channels[0]
            channel_id = channel.get("channel_id")
            print(f"Found channel: {channel.get('name')} (@{channel.get('handle')}) - ID: {channel_id}")
            
            # Try the dedicated video endpoint first
            print(f"Fetching {content_type}s from channel via dedicated endpoint...")
            videos = fetch_channel_videos(
                channel_id=channel_id,
                video_type=content_type,
                min_views=request.min_views or 0,
                max_days=request.max_days_old or 365,
            )
            
            # If dedicated endpoint failed, use embedded videos from channel search
            if not videos:
                print("Dedicated endpoint returned no videos, using embedded videos from channel search...")
                embedded_videos = channel.get("videos" if content_type == "video" else "shorts", [])
                
                if embedded_videos:
                    import datetime
                    # Get channel average views for outlier calculations
                    channel_avg_views = channel.get("avg_views", 0)
                    
                    # Fetch detailed stats (likes, comments) for all videos in one batch
                    video_ids = [vid.get("id") for vid in embedded_videos if vid.get("id")]
                    video_details = fetch_video_details(video_ids)
                    
                    for vid in embedded_videos:
                        title = vid.get("title", "")
                        
                        # Parse date
                        published_at = vid.get("publishedAtEstimate", "")
                        days_old = get_youtube_days_old(published_at)
                        max_days = min(max(request.max_days_old or 30, 1), 365)
                        if days_old < 0 or days_old > max_days:
                            continue
                        
                        # Get thumbnail (handle both list and dict formats)
                        thumbnails = vid.get("thumbnails", {})
                        thumb_url = f"https://i.ytimg.com/vi/{vid.get('id')}/hqdefault.jpg"  # default fallback
                        
                        if isinstance(thumbnails, dict):
                            thumb_url = (
                                thumbnails.get("high", {}).get("url") or
                                thumbnails.get("medium", {}).get("url") or
                                thumbnails.get("default", {}).get("url") or
                                thumb_url
                            )
                        elif isinstance(thumbnails, list) and len(thumbnails) > 0:
                            # TubeLab sometimes returns thumbnails as a list
                            thumb_url = thumbnails[0].get("url", thumb_url) if isinstance(thumbnails[0], dict) else thumb_url
                        
                        # Get view count from embedded data or enriched details
                        vid_id = vid.get("id")
                        details = video_details.get(vid_id, {})
                        view_count = details.get("viewCount") or vid.get("viewCount", 0)
                        like_count = details.get("likeCount", 0)
                        comment_count = details.get("commentCount", 0)
                        
                        # Calculate outlier score (multiply) = views / channel average
                        if channel_avg_views and channel_avg_views > 0:
                            outlier_score = round(view_count / channel_avg_views, 2)
                        else:
                            # Fallback: use TubeLab's isPositiveOutlier flag
                            vid_stats = vid.get("statistics", {})
                            is_outlier = vid_stats.get("isPositiveOutlier", False) if isinstance(vid_stats, dict) else False
                            outlier_score = 2.0 if is_outlier else 1.0
                        
                        # Calculate cross-niche score with hook bonuses (same as regular search)
                        # For channel search, we don't filter by niche - user explicitly chose this channel
                        cross_niche_score = calculate_cross_niche_score(title, outlier_score, apply_niche_filter=False)
                        
                        # Calculate engagement rate
                        engagement_rate = None
                        if view_count and view_count > 0:
                            engagement_rate = round(((like_count or 0) + (comment_count or 0)) / view_count * 100, 2)
                        
                        videos.append({
                            "video_id": vid_id,
                            "title": title,
                            "url": f"https://www.youtube.com/watch?v={vid_id}",
                            "view_count": view_count,
                            "like_count": like_count,
                            "comment_count": comment_count,
                            "duration": parse_youtube_duration_seconds(vid.get("duration", 0)),
                            "channel_name": channel.get("name", ""),
                            "channel_handle": channel.get("handle", ""),
                            "channel_id": channel_id,
                            "channel_subscribers": channel.get("subscribers", 0),
                            "thumbnail_url": thumb_url,
                            "days_old": days_old,
                            "date": published_at,
                            "outlier_score": outlier_score,
                            "cross_niche_score": cross_niche_score,
                            "engagement_rate": engagement_rate,
                            "is_short": content_type == "short",
                            "source": f"channel: @{channel.get('handle', channel_id)}",
                        })
                    
                    # Newest first for the same reason as the dedicated endpoint above:
                    # only the leading 50 survive, and score ordering buries recent uploads.
                    videos.sort(key=lambda x: x.get("days_old", 99999))
            
            if content_type == "video":
                max_duration = min(max(request.max_duration or 1800, 60), 3600)
                videos = [
                    video for video in videos
                    if 60 < parse_youtube_duration_seconds(video.get("duration")) <= max_duration
                ]

            print(f"Found {len(videos)} videos from channel")
            
            if len(videos) == 0:
                return {
                    "results": [], 
                    "channel_id": channel_id,
                    "error": "No videos found for this channel. The channel may be new or have no public videos."
                }
            
            return {"results": videos[:50], "channel_id": channel_id}
        
        # Outliers search mode (default)
        all_videos = []
        mode = request.mode or "cross-niche"
        
        for keyword in request.keywords:
            videos = search_tubelab_outliers(
                query=keyword,
                size=40,
                min_views=request.min_views if request.min_views is not None else 0,
                max_days=request.max_days_old or 30,
                video_type=request.content_type or "video",
                mode=mode,
                language=request.output_language or "en",
                max_duration=min(max(request.max_duration or 1800, 60), 3600),
            )
            all_videos.extend(videos)
        
        # Remove duplicates by video_id
        seen = set()
        unique_videos = []
        for v in all_videos:
            if v["video_id"] not in seen:
                seen.add(v["video_id"])
                unique_videos.append(v)

        # Restore the original niche-specific behavior: TubeLab can return
        # adjacent results for a broad query, so require at least one of the
        # user's filter terms to appear in the title. Cross-niche mode
        # intentionally keeps adjacent industries for transferable patterns.
        filter_terms = [
            term.strip().lower()
            for term in (request.filter_terms or [])
            if term and term.strip()
        ]
        if mode == "niche-specific" and filter_terms:
            unique_videos = [
                video for video in unique_videos
                if any(
                    term in str(video.get("title", "")).lower()
                    for term in filter_terms
                )
            ]

        # Sort by cross_niche_score (which has hook bonuses applied)
        unique_videos.sort(key=lambda x: x.get("cross_niche_score", 0), reverse=True)
        
        result_limit = min(max(request.result_limit or 50, 1), 200)
        return {
            "results": unique_videos[:result_limit],
            "searched": len(all_videos),
            "unique": len(unique_videos),
        }
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.post("/instagram-research")
async def instagram_research_endpoint(request: InstagramResearchRequest, _: bool = Depends(verify_api_key)):
    """Run Instagram research via Apify."""
    apify_token = os.getenv("APIFY_API_TOKEN")
    if not apify_token:
        return {"error": "APIFY_API_TOKEN not configured", "results": []}
    
    try:
        from apify_client import ApifyClient
        from datetime import datetime, timezone
        import re
        
        handles = list(dict.fromkeys(
            handle.lstrip("@").strip()
            for handle in request.handles
            if handle and handle.lstrip("@").strip()
        ))
        requested_hashtags = list(dict.fromkeys(
            re.sub(r"[^A-Za-z0-9_]", "", hashtag.lstrip("#").strip())
            for hashtag in request.hashtags
            if hashtag and re.sub(r"[^A-Za-z0-9_]", "", hashtag.lstrip("#").strip())
        ))
        if not handles and not requested_hashtags:
            return {"results": []}
        requested_handle_keys = {handle.lower() for handle in handles}

        total_limit = min(max(request.limit or 50, 1), 100)
        max_days = min(max(request.max_days or 90, 1), 365)
        source_count = len(handles) or len(requested_hashtags) or 1
        per_source_limit = min(
            50,
            max(6, (total_limit + source_count - 1) // source_count),
        )
        all_posts = []

        import asyncio

        def _fetch_profiles():
            profile_client = ApifyClient(apify_token)
            run = profile_client.actor("apify/instagram-profile-scraper").call(
                run_input={
                    "usernames": handles,
                    "resultsLimit": len(handles),
                },
                timeout_secs=120
            )
            return list(profile_client.dataset(run["defaultDatasetId"]).iterate_items())

        def _fetch_reels():
            reel_client = ApifyClient(apify_token)
            run = reel_client.actor("apify/instagram-reel-scraper").call(
                run_input={
                    "username": handles,
                    # Actor defines this as a per-username limit.
                    "resultsLimit": per_source_limit,
                    "onlyPostsNewerThan": f"{max_days} days",
                    "skipPinnedPosts": True,
                },
                timeout_secs=180
            )
            return list(reel_client.dataset(run["defaultDatasetId"]).iterate_items())

        def _fetch_hashtag_reels(hashtags_to_fetch):
            hashtag_client = ApifyClient(apify_token)
            run = hashtag_client.actor("apify/instagram-hashtag-scraper").call(
                run_input={
                    "hashtags": hashtags_to_fetch,
                    "resultsLimit": per_source_limit,
                    "resultsType": "reels",
                    "onlyPostsNewerThan": f"{max_days} days",
                },
                timeout_secs=180
            )
            return list(hashtag_client.dataset(run["defaultDatasetId"]).iterate_items())

        if handles:
            # Account mode uses profile metadata and a dedicated Reel scrape in
            # parallel. This preserves the existing exact-owner cache behavior.
            profile_result, reel_result = await asyncio.gather(
                asyncio.to_thread(_fetch_profiles),
                asyncio.to_thread(_fetch_reels),
                return_exceptions=True,
            )
            profile_items = [] if isinstance(profile_result, Exception) else profile_result
            if isinstance(reel_result, Exception):
                if not profile_items:
                    raise reel_result
                reel_items = []
            else:
                reel_items = reel_result
        elif requested_hashtags:
            profile_items = []
            reel_items = await asyncio.to_thread(_fetch_hashtag_reels, requested_hashtags)

        profile_followers = {
            str(item.get("username", "")).lower(): item.get("followersCount", 0) or 0
            for item in profile_items
            if item.get("username")
        }
        profile_by_handle = {
            str(item.get("username", "")).lower(): item
            for item in profile_items
            if item.get("username")
        }

        # The dedicated Reel actor occasionally returns related/collaborating
        # accounts instead of the requested owner, or no rows despite the
        # profile actor exposing recent Reels. Add exact-owner profile posts as
        # a fallback, then deduplicate before normalizing the results.
        for profile in profile_items:
            profile_username = str(profile.get("username", "")).lstrip("@").strip()
            if profile_username.lower() not in requested_handle_keys:
                continue
            for post in profile.get("latestPosts", []) or []:
                post_type = str(post.get("type") or "").lower()
                product_type = str(post.get("productType") or "").lower()
                if post_type != "video" and product_type not in {"clips", "reels"}:
                    continue
                post_owner = str(post.get("ownerUsername") or profile_username).lstrip("@").strip()
                if post_owner.lower() != profile_username.lower():
                    continue
                timestamp = post.get("timestamp") or post.get("takenAtTimestamp")
                try:
                    if isinstance(timestamp, (int, float)):
                        post_date = datetime.fromtimestamp(timestamp, tz=timezone.utc)
                    else:
                        post_date = datetime.fromisoformat(str(timestamp).replace("Z", "+00:00"))
                    if (datetime.now(timezone.utc) - post_date).days > max_days:
                        continue
                except (TypeError, ValueError):
                    continue
                reel_items.append(post)

        deduplicated_reel_items = []
        seen_reel_ids = set()
        for item in reel_items:
            identity = item.get("id") or item.get("shortCode") or item.get("url")
            if not identity or identity in seen_reel_ids:
                continue
            seen_reel_ids.add(identity)
            deduplicated_reel_items.append(item)
        reel_items = deduplicated_reel_items

        def _sort_key(x):
            ts = x.get("timestamp") or x.get("takenAtTimestamp")
            try:
                if isinstance(ts, (int, float)):
                    return float(ts)
                if ts:
                    return datetime.fromisoformat(str(ts).replace("Z", "+00:00")).timestamp()
            except Exception:
                pass
            return 0.0

        reel_items.sort(key=_sort_key, reverse=True)
        per_handle_counts = {}

        for item in reel_items:
                owner_data = item.get("owner") if isinstance(item.get("owner"), dict) else {}
                item_owner = str(
                    item.get("ownerUsername")
                    or owner_data.get("username")
                    or item.get("username")
                    or ""
                ).lstrip("@").strip()
                if not item_owner and len(handles) == 1:
                    item_owner = handles[0]
                if not item_owner:
                    continue
                if requested_handle_keys and item_owner.lower() not in requested_handle_keys:
                    continue
                post_type_value = str(item.get("type") or "").lower()
                product_type_value = str(item.get("productType") or "").lower()
                is_video = bool(
                    item.get("isVideo") is True
                    or item.get("videoUrl")
                    or post_type_value == "video"
                    or product_type_value in {"clips", "reels"}
                )
                if not is_video:
                    continue
                shortcode = item.get("shortCode", "") or ""
                item_id = item.get("id") or shortcode
                url = item.get("url") or (f"https://www.instagram.com/reel/{shortcode}/" if shortcode else "")
                display_url = item.get("displayUrl", "") or item.get("imageUrl", "") or ""
                # Actor error/status rows can appear in the dataset alongside
                # media. Do not turn them into empty fake Reels.
                if not item_id or not url or not display_url:
                    continue
                owner_key = item_owner.lower()
                if per_handle_counts.get(owner_key, 0) >= per_source_limit:
                    continue

                likes = item.get("likesCount", 0) or 0
                comments = item.get("commentsCount", 0) or 0
                video_views = item.get("videoViewCount", 0) or item.get("videoPlayCount", 0) or 0

                owner_username = item_owner
                owner_followers = (
                    item.get("ownerFollowersCount")
                    or owner_data.get("followersCount")
                    or profile_followers.get(owner_key, 0)
                )
                owner_profile = profile_by_handle.get(owner_key, {})

                timestamp = item.get("timestamp") or item.get("takenAtTimestamp")
                days_old = 0
                date_str = ""
                if timestamp:
                    try:
                        if isinstance(timestamp, (int, float)):
                            post_date = datetime.fromtimestamp(timestamp, tz=timezone.utc)
                        else:
                            post_date = datetime.fromisoformat(str(timestamp).replace("Z", "+00:00"))
                        now = datetime.now(timezone.utc)
                        days_old = (now - post_date).days
                        date_str = post_date.strftime("%Y-%m-%d")
                    except Exception:
                        pass
                if days_old > max_days:
                    continue
                per_handle_counts[owner_key] = per_handle_counts.get(owner_key, 0) + 1

                # Follower-based when available; fallback to view-based for reels
                if owner_followers > 0:
                    engagement_rate = round(((likes + comments) / owner_followers) * 100, 2)
                elif video_views > 0:
                    engagement_rate = round(((likes + comments) / video_views) * 100, 2)
                else:
                    engagement_rate = 0.0

                caption = item.get("caption", "") or ""
                hashtags = re.findall(r'#(\w+)', caption)
                post_type = item.get("type") or item.get("productType") or "Video"

                all_posts.append({
                    "id": item_id,
                    "shortcode": shortcode,
                    "url": url,
                    "type": post_type,
                    "caption": caption,
                    "likes": likes,
                    "comments": comments,
                    "video_views": video_views,
                    "days_old": days_old,
                    "date": date_str,
                    "owner_username": owner_username,
                    "owner_followers": owner_followers,
                    "owner_display_name": (
                        owner_profile.get("fullName", "")
                        or item.get("ownerFullName", "")
                        or ""
                    ),
                    "owner_profile_pic_url": (
                        owner_profile.get("profilePicUrl", "")
                        or item.get("ownerProfilePicUrl", "")
                        or owner_data.get("profilePicUrl", "")
                        or ""
                    ),
                    "owner_biography": owner_profile.get("biography", "") or "",
                    "owner_is_verified": bool(owner_profile.get("isVerified", False)),
                    "display_url": display_url,
                    "video_url": item.get("videoUrl", "") or "",
                    "hashtags": hashtags[:10],
                    "is_video": is_video,
                    "engagement_rate": engagement_rate,
                    "outlier_score": 1.0,
                    "cross_niche_score": 1.0,
                    "analysis": "",
                    "variant_1": "",
                    "variant_2": "",
                    "variant_3": "",
                })
        
        # Calculate outlier scores per account: compare each post's likes
        # against that account's average likes (same approach as YouTube)
        from collections import defaultdict
        account_posts = defaultdict(list)
        for post in all_posts:
            account_posts[post["owner_username"]].append(post)
        
        for username, posts in account_posts.items():
            likes_list = [p["likes"] for p in posts]
            avg_likes = sum(likes_list) / len(likes_list) if likes_list else 0
            
            for post in posts:
                if avg_likes > 0:
                    score = round(post["likes"] / avg_likes, 1)
                else:
                    score = 1.0
                score = max(0.1, score)
                post["outlier_score"] = score
                post["cross_niche_score"] = score
        
        # Sort by cross_niche_score descending
        all_posts.sort(key=lambda x: x["cross_niche_score"], reverse=True)
        
        return {"results": all_posts[:total_limit]}
        
    except Exception as e:
        import traceback
        return {"error": f"{str(e)}\n{traceback.format_exc()}", "results": []}


@app.post("/generate-script")
