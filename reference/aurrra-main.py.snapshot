# ============================================
# OBSERVABILITY
# ============================================

# Mirrors sentry.server.config.ts on the Next.js side, including its sample rate.
# With no SENTRY_DSN set this block does nothing and the service behaves exactly as
# it did before, which is what makes it safe to deploy ahead of configuring Railway.
#
# The import is guarded on purpose: a missing or broken sentry-sdk must never be the
# reason this service fails to start. Error reporting is worth having, not worth an
# outage.
SENTRY_DSN = os.getenv("SENTRY_DSN")
_sentry = None

if SENTRY_DSN:
    try:
        import sentry_sdk

        sentry_sdk.init(
            dsn=SENTRY_DSN,
            traces_sample_rate=0.1,
            environment=os.getenv("RAILWAY_ENVIRONMENT_NAME", "production"),
        )
        _sentry = sentry_sdk
        print("[sentry] initialised")
    except Exception as exc:
        print(f"[sentry] init skipped: {type(exc).__name__}: {exc}")


def report_error(message: str) -> None:
    """Print an operational failure and send it to Sentry when configured.

    For failures that would otherwise be invisible: a misconfiguration, or a
    background task that cannot report through its usual channel because that
    channel is the thing that is broken. Reporting must never itself raise.
    """
    print(message)
    if _sentry is None:
        return
    try:
        _sentry.capture_message(message, level="error")
    except Exception:
        pass


# ============================================
# BUILD IDENTITY
# ============================================
#
# Railway does not inject RAILWAY_GIT_COMMIT_SHA for this service, so we cannot read
# the deployed commit at runtime. Instead we fingerprint this file's own contents at
# import time. The fingerprint changes whenever main.py changes, which is exactly the
# question we keep needing to answer: "did my change actually deploy?" A human-readable
# commit can be layered on later by setting GIT_COMMIT_SHA as a Railway variable.
def _compute_source_fingerprint() -> str:
    try:
        import hashlib

        with open(__file__, "rb") as fh:
            return hashlib.sha256(fh.read()).hexdigest()[:12]
    except Exception:
        return "unknown"


SOURCE_FINGERPRINT = _compute_source_fingerprint()
COMMIT_SHA = os.getenv("GIT_COMMIT_SHA") or None


def build_info() -> dict:
    """Identity of the running build, safe to expose on a health endpoint."""
    return {
        "source_fingerprint": SOURCE_FINGERPRINT,
        "commit": COMMIT_SHA,
        "sentry": _sentry is not None,
        "environment": os.getenv("RAILWAY_ENVIRONMENT_NAME", "unknown"),
    }


# ============================================
# AUTH
# ============================================

def verify_api_key(authorization: str = Header(None)):
    """Verify the API key from the Authorization header."""
    expected_key = os.getenv("PYTHON_SERVICE_SECRET", "")
    
    if not authorization:
        raise HTTPException(status_code=401, detail="Missing authorization header")
    
    token = authorization.replace("Bearer ", "") if authorization.startswith("Bearer ") else authorization
    
    if not valid_secret(token, expected_key):
        raise HTTPException(status_code=403, detail="Invalid API key")
    
    return True


# ============================================
# CROSS-NICHE SCORING (hardcoded for now - TODO: move to user profile/onboarding)
# ============================================

# OWN NICHE - Hard exclude for cross-niche mode (we want CROSS-niche, not our niche)
# TODO: This should come from user's brand profile after onboarding
OWN_NICHE_TERMS = [
    "ai", "a.i.", "a.i", " ai ", "artificial intelligence",
    "gpt", "chatgpt", "chat gpt", "claude", "llm", "gemini",
    "machine learning", "neural network", "deep learning", "openai", "anthropic",
    "midjourney", "stable diffusion", "dall-e", "copilot",
    "automation", "automate", "automated", "n8n", "make.com", "zapier", "workflow",
    "agent", "agentic", "langchain", "langgraph", "crewai", "autogen", "autogpt",
    "code", "coding", "programming", "programmer", "developer", "python", "javascript",
    "api", "sdk", "github", "docker", "kubernetes", "aws",
    "cursor", "replit", "vs code", "vscode", "terminal",
]

# NON-TRANSFERABLE FORMATS - Heavy penalty
EXCLUDE_FORMATS = [
    "setup", "desk setup", "tour", "room tour", "unboxing", "review",
    "challenge", "prank", "react", "roast", "exposed", "drama",
    "day in my life", "morning routine", "what i eat", "grwm",
    "travel vlog", "vacation", "wedding", "birthday",
    "q&a", "ama", "podcast ep", "live stream", "behind the scenes",
    "breaking news", "election", "trump", "biden", "crypto", "bitcoin",
    "gameplay", "minecraft", "fortnite", "gaming", "asmr", "mukbang",
]

# Positive scoring hooks
MONEY_HOOKS = ["$", "revenue", "income", "profit", "money", "earn", "million", "millionaire", "rich", "wealth"]
TIME_HOOKS = ["faster", "save time", "productivity", "efficient", "quick", "hack", "hacks", "shortcut"]
CURIOSITY_HOOKS = ["secret", "secrets", "nobody", "changed everything", "game changer", "truth about", "hidden"]
TRANSFORMATION_HOOKS = ["before", "after", "transformed", "from zero", "how i built", "changed my life"]
CONTRARIAN_HOOKS = ["wrong", "mistake", "myth", "overrated", "underrated", "why i stopped", "the problem with"]
URGENCY_HOOKS = ["before it's too late", "last chance", "don't miss", "must watch", "need to know"]


def calculate_cross_niche_score(title: str, base_outlier_score: float, apply_niche_filter: bool = True) -> float:
    """
    Calculate cross-niche potential score with filtering and hook bonuses.
    
    Args:
        title: Video title
        base_outlier_score: Raw outlier score from TubeLab (averageViewsRatio)
        apply_niche_filter: If True, excludes own niche (cross-niche mode). If False, skips niche filtering.
    
    Returns:
        Adjusted score (0 if filtered out in cross-niche mode)
    """
    title_lower = title.lower()
    score = base_outlier_score

    # In cross-niche mode, hard exclude own niche
    if apply_niche_filter:
        if any(term in title_lower for term in OWN_NICHE_TERMS):
            return 0

    # Heavy penalty for non-transferable formats
    if any(fmt in title_lower for fmt in EXCLUDE_FORMATS):
        score *= 0.3

    # Bonuses for proven hooks
    if any(hook in title_lower for hook in MONEY_HOOKS):
        score *= 1.4
    if any(hook in title_lower for hook in CURIOSITY_HOOKS):
        score *= 1.3
    if any(hook in title_lower for hook in TRANSFORMATION_HOOKS):
        score *= 1.25
    if any(hook in title_lower for hook in CONTRARIAN_HOOKS):
        score *= 1.25
    if any(hook in title_lower for hook in TIME_HOOKS):
        score *= 1.2
    if any(hook in title_lower for hook in URGENCY_HOOKS):
        score *= 1.15
    # Numbers in title bonus
    if re.search(r'\b\d+\b', title):
        score *= 1.1

    return round(score, 2)


