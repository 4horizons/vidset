# HELPER FUNCTIONS - YOUTUBE RESEARCH
# ============================================

def search_tubelab_outliers(query: str, size: int = 40, min_views: int = 0,
                            max_days: int = 30, video_type: str = "video",
                            mode: str = "cross-niche", language: str = "en",
                            max_duration: int = 1800) -> list:
    """Search TubeLab for outlier videos.
    
    Args:
        mode: 'cross-niche' filters out own niche and applies hook bonuses.
              'niche-specific' uses raw outlier score without filtering.
    """
    if not TUBELAB_API_KEY:
        print("ERROR: TUBELAB_API_KEY not set")
        return []

    headers = {
        "Authorization": f"Api-Key {TUBELAB_API_KEY}",
        "Accept": "application/json"
    }
    
    # Calculate date filter
    published_after = (datetime.datetime.now() - datetime.timedelta(days=max_days)).strftime("%Y-%m-%dT00:00:00Z")

    tubelab_lang = language[:2] if language else "en"
    params = {
        "query": query,
        "size": size,
        "type": video_type,
        "viewCountFrom": min_views,
        "language": tubelab_lang,
        "publishedAtFrom": published_after,
    }

    try:
        response = requests.get(
            f"{TUBELAB_BASE_URL}/search/outliers",
            headers=headers,
            params=params,
            timeout=30
        )
        response.raise_for_status()
        data = response.json()

        videos = []
        for hit in data.get("hits", []):
            snippet = hit.get("snippet", {})
            stats = hit.get("statistics", {})
            
            thumbnails = snippet.get("thumbnails", {})
            thumb_url = (
                thumbnails.get("high", {}).get("url") or
                thumbnails.get("medium", {}).get("url") or
                f"https://i.ytimg.com/vi/{hit['id']}/maxresdefault.jpg"
            )
            
            published_at = snippet.get("publishedAt", "")
            days_old = get_youtube_days_old(published_at)
            if days_old < 0 or days_old > max_days:
                continue

            # Calculate outlier score from TubeLab's averageViewsRatio
            outlier = round(stats.get("averageViewsRatio", 1.0), 2)
            duration_seconds = parse_youtube_duration_seconds(snippet.get("duration", 0))
            title = snippet.get("title", "")
            
            # Calculate cross-niche score (applies filtering and hook bonuses)
            apply_niche_filter = (mode == "cross-niche")
            cross_score = calculate_cross_niche_score(title, outlier, apply_niche_filter)
            
            # Skip videos filtered out in cross-niche mode (score = 0)
            if cross_score == 0:
                continue
            
            # Get stats
            view_count = stats.get("viewCount", 0)
            like_count = stats.get("likeCount", 0)
            comment_count = stats.get("commentCount", 0)
            
            # Calculate engagement rate: (likes + comments) / views * 100
            engagement_rate = None
            if view_count and view_count > 0:
                engagement_rate = round(((like_count or 0) + (comment_count or 0)) / view_count * 100, 2)
            
            video = {
                "video_id": hit.get("id"),
                "title": title,
                "url": f"https://www.youtube.com/watch?v={hit['id']}",
                "view_count": view_count,
                "like_count": like_count,
                "comment_count": comment_count,
                "duration": duration_seconds,
                "channel_name": snippet.get("channelTitle", ""),
                "channel_handle": snippet.get("channelHandle", ""),
                "channel_id": snippet.get("channelId", ""),
                "channel_subscribers": snippet.get("channelSubscribers", 0),
                "thumbnail_url": thumb_url,
                "days_old": days_old,
                "date": published_at or "",
                # Outlier metrics
                "outlier_score": outlier,  # Raw TubeLab score
                "cross_niche_score": cross_score,  # Adjusted with hooks/filters (this is displayed)
                "engagement_rate": engagement_rate,  # (likes + comments) / views * 100
                "z_score": 0,
                # Content classification
                "category": "",
                "sentiment": "",
                "is_faceless": None,
                "is_short": duration_seconds < 60,
                "quality": "",
            }
            videos.append(video)

        # Filter by content type (safety filter in case TubeLab doesn't filter perfectly)
        if video_type == "video":
            # Long-form only: exclude shorts (< 60s)
            videos = [v for v in videos if not v.get("is_short", False)]
            if max_duration > 0:
                videos = [
                    v for v in videos
                    if 0 < parse_youtube_duration_seconds(v.get("duration")) <= max_duration
                ]
        elif video_type == "short":
            # Shorts only: include only shorts (< 60s)
            videos = [v for v in videos if v.get("is_short", False)]
        # "all" = no filtering

        return videos

    except requests.exceptions.RequestException as e:
        print(f"TubeLab API error: {str(e)[:100]}")
        return []


def resolve_channel_handle(handle: str) -> Optional[str]:
    """Resolve a YouTube channel handle to a channel ID using TubeLab.
    
    Args:
        handle: Channel handle like '@realmattgray' or 'realmattgray'
        
    Returns:
        Channel ID (24-character string) or None if not found
    """
    if not TUBELAB_API_KEY:
        print("ERROR: TUBELAB_API_KEY not set")
        return None
    
    # Clean handle for comparison
    clean_handle = handle.lstrip("@").strip().lower()
    
    # ALWAYS include @ in query for better handle matching
    search_query = f"@{clean_handle}"
    
    headers = {
        "Authorization": f"Api-Key {TUBELAB_API_KEY}",
        "Accept": "application/json"
    }
    
    try:
        # Search for channels matching the handle
        response = requests.get(
            f"{TUBELAB_BASE_URL}/search/channels",
            headers=headers,
            params={
                "query": search_query,
                "size": 10,
            },
            timeout=30
        )
        response.raise_for_status()
        data = response.json()
        
        hits = data.get("hits", [])
        print(f"Channel search for '{search_query}' returned {len(hits)} results")
        
        # Find exact match by handle
        for hit in hits:
            snippet = hit.get("snippet", {})
            # TubeLab uses 'handle' not 'channelHandle'
            channel_handle = (snippet.get("handle") or snippet.get("channelHandle") or "").lstrip("@").lower()
            if channel_handle == clean_handle:
                print(f"Found exact handle match: @{channel_handle}")
                return hit.get("id")
        
        # If no exact match, return first result if available
        if hits:
            first_handle = hits[0].get("snippet", {}).get("handle", "")
            print(f"No exact match for @{clean_handle}, using first result: {first_handle}")
            return hits[0].get("id")
            
        return None
        
    except requests.exceptions.RequestException as e:
        print(f"TubeLab channel search error: {str(e)[:100]}")
        return None


def fetch_video_details(video_ids: list[str]) -> dict:
    """Fetch detailed video statistics (likes, comments) from TubeLab.
    
    Args:
        video_ids: List of YouTube video IDs
        
    Returns:
        Dict mapping video_id to {likeCount, commentCount, viewCount}
    """
    if not TUBELAB_API_KEY or not video_ids:
        return {}
    
    headers = {
        "Authorization": f"Api-Key {TUBELAB_API_KEY}",
        "Accept": "application/json"
    }
    
    try:
        # TubeLab accepts comma-separated video IDs
        ids_param = ",".join(video_ids[:50])  # Limit to 50 videos
        
        response = requests.get(
            f"{TUBELAB_BASE_URL}/video/{ids_param}",
            headers=headers,
            timeout=30
        )
        response.raise_for_status()
        data = response.json()
        
        # Build lookup dict
        result = {}
        for item in data.get("items", []):
            stats = item.get("statistics", {})
            result[item.get("id")] = {
                "likeCount": stats.get("likeCount", 0),
                "commentCount": stats.get("commentCount", 0),
                "viewCount": stats.get("viewCount", 0),
            }
        
        print(f"Fetched details for {len(result)} videos")
        return result
        
    except requests.exceptions.RequestException as e:
        print(f"TubeLab video details error: {str(e)[:100]}")
        return {}


def search_youtube_channels(query: str, limit: int = 5) -> list:
    """Search for YouTube channels matching a query.
    
    Returns a list of channel objects with id, name, handle, subscribers, avatar.
    """
    if not TUBELAB_API_KEY:
        return []
    
    headers = {
        "Authorization": f"Api-Key {TUBELAB_API_KEY}",
        "Accept": "application/json"
    }
    
    # Preserve handle-style lookup for a single token, but allow topic phrases
    # such as "AI automations" to search by channel name/description.
    clean_query = query.strip()
    if " " not in clean_query and not clean_query.startswith("@"):
        clean_query = f"@{clean_query}"
    
    try:
        response = requests.get(
            f"{TUBELAB_BASE_URL}/search/channels",
            headers=headers,
            params={
                "query": clean_query,
                "size": limit,
            },
            timeout=30
        )
        response.raise_for_status()
        data = response.json()
        
        hits = data.get("hits", [])
        print(f"Channel search for '{clean_query}' returned {len(hits)} hits")
        channels = []
        
        # Debug: log first hit structure to understand TubeLab response
        if hits:
            print(f"First hit keys: {list(hits[0].keys())}")
            snippet = hits[0].get("snippet", {})
            print(f"First snippet keys: {list(snippet.keys())}")
            print(f"First channel title: {snippet.get('title')}")
            print(f"First channelHandle: {snippet.get('channelHandle')}")
            print(f"First customUrl: {snippet.get('customUrl')}")
            stats = hits[0].get("statistics", {})
            print(f"First subscribers: {stats.get('subscriberCount')}")
        
        for hit in hits:
            snippet = hit.get("snippet", {})
            statistics = hit.get("statistics", {})
            thumbnails = snippet.get("thumbnails", {})
            
            avatar_url = (
                thumbnails.get("high", {}).get("url") or
                thumbnails.get("medium", {}).get("url") or
                thumbnails.get("default", {}).get("url") or
                ""
            )
            
            # TubeLab returns handle in snippet.handle (not channelHandle)
            handle = (
                snippet.get("handle") or 
                snippet.get("channelHandle") or 
                snippet.get("customUrl") or 
                ""
            )
            
            # Get videos and shorts from the search result (no separate API call needed)
            videos_data = hit.get("videos", [])
            shorts_data = hit.get("shorts", [])
            
            channels.append({
                "channel_id": hit.get("id"),
                "name": snippet.get("title", ""),
                "handle": handle.lstrip("@") if handle else "",
                "subscribers": statistics.get("subscriberCount", 0),
                "video_count": statistics.get("videosCount", 0),
                "avatar_url": avatar_url,
                "description": snippet.get("description", "")[:150],
                "videos": videos_data,  # Include sample videos
                "shorts": shorts_data,  # Include sample shorts
                # Channel stats for outlier calculations
                "avg_views": statistics.get("averageViewsEstimate", 0),
                "median_views": statistics.get("medianViewsEstimate", 0),
                "std_views": statistics.get("standardDeviationViewsEstimate", 0),
            })
        
        # Sort by subscriber count descending (most popular first)
        channels.sort(key=lambda x: x.get("subscribers", 0), reverse=True)
        
        return channels
        
    except requests.exceptions.RequestException as e:
        print(f"TubeLab channel search error: {str(e)[:100]}")
        return []


def fetch_channel_videos(channel_id: str, video_type: str = "video", 
                         min_views: int = 0, max_days: int = 365) -> list:
    """Fetch videos from a specific YouTube channel via TubeLab.
    
    Args:
        channel_id: YouTube channel ID (24-character string)
        video_type: 'video' for long-form, 'short' for shorts
        min_views: Minimum view count filter
        max_days: Maximum age in days
        
    Returns:
        List of video objects
    """
    if not TUBELAB_API_KEY:
        print("ERROR: TUBELAB_API_KEY not set")
        return []
    
    headers = {
        "Authorization": f"Api-Key {TUBELAB_API_KEY}",
        "Accept": "application/json"
    }
    
    try:
        # Use the appropriate endpoint based on video type
        if video_type == "short":
            endpoint = f"{TUBELAB_BASE_URL}/channel/shorts/{channel_id}"
        else:
            endpoint = f"{TUBELAB_BASE_URL}/channel/videos/{channel_id}"
        
        response = requests.get(
            endpoint,
            headers=headers,
            timeout=30
        )
        response.raise_for_status()
        data = response.json()
        
        print(f"TubeLab response keys: {list(data.keys())}")
        
        # TubeLab channel endpoints return data in 'item' key with nested structure
        # Structure: { id, time, item: { snippet, statistics, videos: [...] } }
        item = data.get("item", {})
        videos_data = item.get("videos", data.get("videos", []))
        print(f"Raw videos count from TubeLab: {len(videos_data)}")
        
        # Channel info is in item.snippet
        channel_snippet = item.get("snippet", data.get("channel", {}).get("snippet", {}))
        channel_stats = item.get("statistics", {})
        
        # Enrich with likes/comments via batch video details lookup. That lookup covers
        # only the first 50 ids, and the caller serves the 50 newest, so order these by
        # recency first: otherwise the videos enriched and the videos served can be
        # different sets, and the newest would silently carry no likes or comments.
        videos_data = sorted(
            videos_data,
            key=lambda vid: vid.get("publishedAtEstimate") or "",
            reverse=True,
        )
        video_ids = [vid.get("id") for vid in videos_data if vid.get("id")]
        video_details = fetch_video_details(video_ids) if video_ids else {}
        print(f"Enriched {len(video_details)} videos with like/comment details")
        
        videos = []
        for vid in videos_data:
            # TubeLab channel endpoint returns data at TOP LEVEL, not nested in snippet/statistics
            # Keys: id, title, thumbnails, duration, viewCount, statistics, publishedAtEstimate
            
            # Get title - try top level first, then nested
            title = vid.get("title") or vid.get("snippet", {}).get("title", "")
            
            # Get duration - already in seconds at top level
            duration_seconds = parse_youtube_duration_seconds(vid.get("duration", 0))
            
            is_short = duration_seconds > 0 and duration_seconds <= 60
            
            # Parse published date - try publishedAtEstimate first
            published_at = vid.get("publishedAtEstimate") or vid.get("snippet", {}).get("publishedAt", "")
            days_old = get_youtube_days_old(published_at)
            
            # Skip if too old
            if days_old < 0 or (max_days and days_old > max_days):
                continue
            
            # Get view count - try top level first
            view_count = vid.get("viewCount") or vid.get("statistics", {}).get("viewCount", 0)
            
            # Skip if below min views
            if min_views and view_count < min_views:
                continue
            
            # Get like/comment counts from enriched video details (batch API call)
            vid_details = video_details.get(vid.get("id"), {})
            like_count = vid_details.get("likeCount", 0)
            comment_count = vid_details.get("commentCount", 0)
            
            # Calculate engagement rate
            engagement_rate = None
            if view_count and view_count > 0:
                engagement_rate = round(((like_count or 0) + (comment_count or 0)) / view_count * 100, 2)
            
            # Get thumbnail - try top level first
            thumbnails = vid.get("thumbnails") or vid.get("snippet", {}).get("thumbnails", {})
            thumb_url = (
                thumbnails.get("maxres", {}).get("url") or
                thumbnails.get("high", {}).get("url") or
                thumbnails.get("medium", {}).get("url") or
                thumbnails.get("default", {}).get("url") or
                f"https://i.ytimg.com/vi/{vid.get('id')}/hqdefault.jpg"  # Fallback
            )
            
            # Calculate outlier score: use TubeLab's per-video averageViewsRatio if available,
            # otherwise compute from channel-level averageViewsEstimate
            vid_stats = vid.get("statistics", {})
            avg_views_ratio = vid_stats.get("averageViewsRatio", 0)
            if avg_views_ratio and avg_views_ratio > 0:
                outlier_score = round(avg_views_ratio, 2)
            else:
                channel_avg_views = channel_stats.get("averageViewsEstimate", 0)
                if channel_avg_views and channel_avg_views > 0:
                    outlier_score = round(view_count / channel_avg_views, 2)
                else:
                    outlier_score = 1.0
            
            video = {
                "video_id": vid.get("id"),
                "title": title,
                "url": f"https://www.youtube.com/watch?v={vid.get('id')}",
                "view_count": view_count,
                "like_count": like_count,
                "comment_count": comment_count,
                "duration": duration_seconds,
                "channel_name": channel_snippet.get("title", ""),
                "channel_handle": channel_snippet.get("handle") or channel_snippet.get("channelHandle", ""),
                "channel_id": channel_id,
                "channel_subscribers": channel_stats.get("subscriberCount", 0),
                "thumbnail_url": thumb_url,
                "days_old": days_old,
                "date": published_at,
                "outlier_score": outlier_score,
                "cross_niche_score": outlier_score,  # Same as outlier for channel search
                "engagement_rate": engagement_rate,
                "is_short": is_short,
                "source": f"channel: @{channel_snippet.get('handle', channel_snippet.get('channelHandle', channel_id)).lstrip('@')}",
            }
            
            videos.append(video)
        
        # Newest first, because the caller keeps only the leading 50. Ordering by raw
        # views instead let a mature back catalogue fill every slot, so a channel's
        # recent uploads could never appear no matter how well they performed.
        # The client re-sorts by outlier score for display.
        videos.sort(key=lambda x: x.get("days_old", 99999))
        
        return videos
        
    except requests.exceptions.RequestException as e:
        print(f"TubeLab channel fetch error: {str(e)[:100]}")
        return []


# ============================================
# HELPER FUNCTIONS - RESEARCH REPORTS
# ============================================

async def generate_research_report(topic: str, context: str = "", output_language: str = "en") -> dict:
    """Generate a research report using Claude."""
    api_key = os.getenv("ANTHROPIC_API_KEY")
    if not api_key:
        return {"error": "API key not configured"}
    
    try:
        import anthropic
        
        client = anthropic.Anthropic(api_key=api_key)
        
        research_lang = f"\nWrite all text values in {output_language}." if output_language and output_language != "en" else ""
        
        prompt = f"""Generate a comprehensive research report on the following topic for creating video content.

TOPIC: {topic}

{f"ADDITIONAL CONTEXT: {context}" if context else ""}
{research_lang}

Create a research report in the following JSON format:
{{
  "topic": "{topic}",
  "executive_summary": "A 2-3 sentence summary of the key insights",
  "key_facts": ["5-8 interesting, verifiable facts about this topic"],
  "common_misconceptions": ["3-5 things people commonly get wrong"],
  "useful_analogies": ["3-4 analogies that help explain complex concepts"],
  "unique_angles": ["4-6 unique angles or perspectives to explore"],
  "contrast_moments": ["3-4 surprising contrasts or counterintuitive points"],
  "open_questions": ["2-3 thought-provoking questions to engage the audience"],
  "sources": ["Types of sources to reference (books, studies, experts)"]
}}

Return ONLY valid JSON, no additional text."""

        model = os.getenv("ANTHROPIC_MODEL", "claude-sonnet-4-6")
        response = client.messages.create(
            model=model,
            max_tokens=2500,
            messages=[{"role": "user", "content": prompt}]
        )
        
        response_text = response.content[0].text.strip()
        json_match = re.search(r'\{[\s\S]*\}', response_text)
        if json_match:
            report = json.loads(json_match.group())
            report["generated_at"] = dt.now().isoformat()
            return report
        else:
            return {"error": "Failed to parse response"}
            
    except Exception as e:
        return {"error": str(e)}


# ============================================
# HELPER FUNCTIONS - SCRIPT GENERATION
# ============================================

def script_story_instruction(research: dict = None, script_angle: str = None, niche: str = None, website_url: str = None) -> str:
    """Keep voice, but stop the offer from replacing an off-niche story."""
    parts = []
    report = research if isinstance(research, dict) else {}
    title = (report.get("title") or "").strip()
    summary = (report.get("summary") or "").strip()
    insights = [item.strip() for item in (report.get("insights") or []) if isinstance(item, str) and item.strip()]
    if title or summary or insights:
        parts.append("SOURCE STORY (what the audience came for):")
        if title:
            parts.append(f"Video: {title}")
        if summary:
            parts.append(f"What it is about: {summary}")
        if insights:
            parts.append("Why it took off:\n- " + "\n- ".join(insights[:5]))

    angle = (script_angle or "").strip().lower()
    if angle == "stay":
        parts.append(
            "SUBJECT RULES:\n"
            "- The video is about THIS story. Do not replace the subject with the creator's niche, product, or website.\n"
            "- Brand voice is how they sound, not what the video is about.\n"
            "- Do not make their product the mistake, the fix, or the thesis.\n"
            "- CTA must follow from this story. Use a soft close. Do not pitch the website as the solution."
        )
    elif angle == "connect":
        parts.append(
            "SUBJECT RULES:\n"
            "- Keep THIS story as the subject. The creator asked to connect it to their work at the end.\n"
            "- Brand voice is how they sound.\n"
            "- One earned CTA is allowed. Do not let the offer become the whole video."
        )
        if website_url:
            parts.append(f"WEBSITE FOR THAT CLOSE: {website_url}")
    else:
        if niche:
            parts.append(f"NICHE: {niche}")
        if website_url:
            parts.append(f"WEBSITE FOR CTAs: {website_url}")
    return "\n".join(parts)


def sanitize_script_copy(text: str) -> str:
    """Replace em dashes so spoken copy does not read as AI-generated."""
    if not text:
        return text
    cleaned = re.sub(r'\s*—\s*(?=[A-Z“"‘])', '. ', text)
    cleaned = re.sub(r'\s*—\s*', ', ', cleaned)
    cleaned = cleaned.replace('—', ', ')
    return re.sub(r' {2,}', ' ', cleaned)

async def generate_script(mode: str, topic: str, context: str = "", 
                          duration: int = None, research: dict = None,
                          vault_items: list = None, selected_hook_formula: str = None,
                          brand_voice: str = None, content_classification: dict = None,
                          niche: str = None, website_url: str = None,
                          script_angle: str = None,
                          output_language: str = "en", include_title: bool = False) -> dict:
    """Generate a script using Claude with proper template parsing."""
    api_key = os.getenv("ANTHROPIC_API_KEY")
    if not api_key:
        return {"error": "API key not configured"}
    
    try:
        import anthropic
        
        client = anthropic.Anthropic(api_key=api_key)
        
        # Parse vault_items to extract templates properly
        hook_template = None
        structure_template = None
        style_profile = None
        
        if vault_items:
            for item in vault_items:
                item_type = item.get('type', '')
                payload = item.get('payload_json', {})
                
                if item_type == 'hook_template':
                    hook_template = {
                        'type': payload.get('type', ''),
                        'structure': payload.get('structure', ''),
                        'examples': payload.get('examples', []),
                        'psychological_trigger': payload.get('psychological_trigger', ''),
                    }
                elif item_type == 'structure_template':
                    structure_template = {
                        'sections': payload.get('sections', []),
                        'best_for': payload.get('best_for', ''),
                        'total_duration_range': payload.get('total_duration_range', ''),
                    }
                elif item_type == 'style_profile':
                    style_profile = {
                        'tone': payload.get('tone', ''),
                        'voice': payload.get('voice', ''),
                        'pacing': payload.get('pacing', ''),
                        'energy': payload.get('energy', ''),
                        'vocabulary_notes': payload.get('vocabulary_notes', ''),
                        'example_phrases': payload.get('example_phrases', []),
                    }
        
        voice_instruction = script_voice_instruction(brand_voice, style_profile)
        format_instruction = script_format_instruction(mode, content_classification)

        # Build hook instruction
        hook_instruction = ""
        if selected_hook_formula:
            hook_instruction = (
                f"HOOK FORMULA TO USE: {selected_hook_formula}\n"
                "Adapt this exact hook pattern to the topic and use it as the only hook.\n"
                "The HOOK section must contain one opening built from this formula, then transition naturally into the script.\n"
                "Do not prepend, append, or combine any other hook formula, pattern, example, or psychological trigger.\n"
            )
        elif hook_template:
            hook_details = []
            if hook_template['structure']:
                hook_details.append(f"Hook structure: {hook_template['structure']}")
            if hook_template['psychological_trigger']:
                hook_details.append(f"Psychological trigger: {hook_template['psychological_trigger']}")
            if hook_template['examples']:
                hook_details.append(f"Example hooks: {hook_template['examples'][0]}")
            if hook_details:
                hook_instruction += '\n'.join(hook_details) + '\n'
        
        # Content classification template structures
        CLASSIFICATION_STRUCTURES = {
            '1A': {'name': 'Common mistakes people make', 'sections': ['HOOK', 'THE MISTAKE', 'WHY IT HAPPENS', 'THE FIX', 'CTA']},
            '1B': {'name': 'Myths vs facts', 'sections': ['HOOK', 'MYTH #1', 'FACT #1', 'MYTH #2', 'FACT #2', 'CTA']},
            '1C': {'name': 'Step-by-step tutorial', 'sections': ['HOOK', 'OVERVIEW', 'STEP 1', 'STEP 2', 'STEP 3', 'RECAP', 'CTA']},
            '1D': {'name': 'Frameworks/formulas', 'sections': ['HOOK', 'THE PROBLEM', 'THE FRAMEWORK', 'ELEMENT 1', 'ELEMENT 2', 'ELEMENT 3', 'CTA']},
            '1E': {'name': 'Quick tips', 'sections': ['HOOK', 'TIP 1', 'TIP 2', 'TIP 3', 'TIP 4', 'TIP 5', 'CTA']},
            '1F': {'name': 'Dos and donts', 'sections': ['HOOK', "DON'T #1", "DO #1", "DON'T #2", "DO #2", 'CTA']},
            '2A': {'name': 'Intro to what you do', 'sections': ['HOOK', 'WHO I AM', 'WHAT I DO', 'WHY I DO IT', 'WHAT YOU GET', 'CTA']},
            '2B': {'name': 'About me doing this', 'sections': ['HOOK', 'WHERE I STARTED', 'THE TURNING POINT', 'WHERE I AM NOW', 'CTA']},
            '2C': {'name': 'Big dream/goal', 'sections': ['HOOK', 'MY VISION', 'WHY IT MATTERS', 'HOW WE GET THERE', 'CTA']},
            '2D': {'name': 'Building in public', 'sections': ['HOOK', 'THE UPDATE', 'WHAT WORKED', 'WHAT DIDNT', 'NEXT STEPS', 'CTA']},
            '2E': {'name': 'Challenge story', 'sections': ['HOOK', 'THE CHALLENGE', 'THE STRUGGLE', 'THE BREAKTHROUGH', 'THE LESSON', 'CTA']},
            '3A': {'name': 'Hypothetical case study', 'sections': ['HOOK', 'THE SCENARIO', 'THE PROBLEM', 'THE SOLUTION', 'THE RESULT', 'CTA']},
            '3B': {'name': 'Client transformation', 'sections': ['HOOK', 'CLIENT BEFORE', 'WHAT WE DID', 'CLIENT AFTER', 'CTA']},
            '3C': {'name': 'Personal transformation', 'sections': ['HOOK', 'BEFORE', 'THE CATALYST', 'THE PROCESS', 'AFTER', 'CTA']},
            '4A': {'name': 'Progress update', 'sections': ['HOOK', 'RECAP', 'THIS EPISODE', 'PROGRESS UPDATE', 'NEXT EPISODE', 'CTA']},
            '4B': {'name': 'Step-by-step series', 'sections': ['HOOK', 'SERIES RECAP', 'TODAYS FOCUS', 'DEEP DIVE', 'KEY TAKEAWAYS', 'CTA']},
            '4C': {'name': 'Challenge series', 'sections': ['HOOK', 'CHALLENGE UPDATE', 'TODAYS TASK', 'RESULTS', 'TOMORROW', 'CTA']},
        }

        story_instruction = script_story_instruction(research, script_angle, niche, website_url)
        
        if mode == "youtube":
            target_length = duration or 600  # 10 minutes default
            
            # Build structure: content_classification > structure_template > default
            if content_classification and content_classification.get('templateType'):
                template_type = content_classification['templateType']
                template_info = CLASSIFICATION_STRUCTURES.get(template_type, {})
                template_name = template_info.get('name', template_type)
                sections = template_info.get('sections', ['HOOK', 'MAIN CONTENT', 'CTA'])
                
                structure_text = f"CONTENT TYPE: {template_name}\n"
                structure_text += "SCRIPT STRUCTURE (follow this exactly):\n"
                for i, section in enumerate(sections, 1):
                    structure_text += f"{i}. {section}\n"
            elif structure_template and structure_template['sections']:
                sections = structure_template['sections']
                structure_text = "SCRIPT STRUCTURE (follow this exactly):\n"
                for i, section in enumerate(sections, 1):
                    name = section.get('name', f'Section {i}')
                    content = section.get('content', '')
                    timing = section.get('timing', '')
                    structure_text += f"{i}. {name}"
                    if timing:
                        structure_text += f" ({timing})"
                    if content:
                        structure_text += f": {content}"
                    structure_text += "\n"
            else:
                structure_text = """SCRIPT STRUCTURE:
1. HOOK (first 30 seconds): Grab attention immediately
2. INTRO: Introduce the topic and promise value  
3. MAIN CONTENT: 3-5 key points with examples
4. CTA: Call to action (subscribe, comment, etc.)
5. OUTRO: Wrap up and tease next video
"""
            
            lang_instruction = f"\nOUTPUT LANGUAGE: Write the entire script in {output_language}. All spoken text must be in {output_language}.\n" if output_language and output_language != "en" else ""
            
            prompt = f"""Write a YouTube video script.

TOPIC: {topic}
TARGET LENGTH: {target_length} seconds (~{target_length // 60} minutes)
{lang_instruction}
{voice_instruction}
{format_instruction}
{hook_instruction}
{f"ADDITIONAL CONTEXT: {context}" if context else ""}
{story_instruction}

{structure_text}

OUTPUT FORMAT - CRITICAL:
- Write ONLY the speakable script text
- Start each section with the section name followed by a colon on its own line
- Keep every listed label as its own header, including numbered ones like MYTH #1, FACT #1, STEP 1, TIP 1, and DON'T #1
- Then write the actual script content as natural paragraphs
- NO markdown formatting (no **, no ##, no *)
- NO timestamps in section headers
- NO word count at the end
- Never use em dashes (—) or en dashes (–). Use a period, comma, or a new sentence instead
- The script should flow naturally when read aloud

Example format:
HOOK:
[Opening line that grabs attention...]

INTRO:
[Introduction content...]

Write the complete script now:"""

        elif mode == "shortform":
            # Build structure from template or use default
            # Build structure: content_classification > structure_template > default
            if content_classification and content_classification.get('templateType'):
                template_type = content_classification['templateType']
                template_info = CLASSIFICATION_STRUCTURES.get(template_type, {})
                template_name = template_info.get('name', template_type)
                sections = template_info.get('sections', ['HOOK', 'VALUE', 'CTA'])
                
                structure_text = f"CONTENT TYPE: {template_name}\n"
                structure_text += "SCRIPT STRUCTURE:\n"
                for i, section in enumerate(sections, 1):
                    structure_text += f"{i}. {section}\n"
            elif structure_template and structure_template['sections']:
                sections = structure_template['sections']
                structure_text = "SCRIPT STRUCTURE:\n"
                for i, section in enumerate(sections, 1):
                    name = section.get('name', f'Section {i}')
                    content = section.get('content', '')
                    structure_text += f"{i}. {name}: {content}\n"
            else:
                structure_text = """SCRIPT STRUCTURE:
1. HOOK: Pattern interrupt, grab attention in first 3 seconds
2. PROBLEM/SETUP: Identify the pain point (5-10 seconds)
3. VALUE/SOLUTION: Deliver the value (30-40 seconds)
4. CTA: Call to action (5 seconds)
"""
            
            sf_lang_instruction = f"\nOUTPUT LANGUAGE: Write the entire script in {output_language}. All spoken text must be in {output_language}.\n" if output_language and output_language != "en" else ""
            
            prompt = f"""Write a short-form video script (60 seconds max).

TOPIC: {topic}
{sf_lang_instruction}
{voice_instruction}
{format_instruction}
{hook_instruction}
{f"ADDITIONAL CONTEXT: {context}" if context else ""}
{story_instruction}

{structure_text}

OUTPUT FORMAT - CRITICAL:
- Write ONLY the speakable script text (under 150 words)
- Start each section with the section name followed by a colon on its own line
- Keep every listed label as its own header, including numbered ones like MYTH #1, FACT #1, STEP 1, TIP 1, and DON'T #1
- Then write the actual script content as a natural paragraph
- NO markdown formatting (no **, no ##, no *)
- NO timestamps
- NO word count
- Never use em dashes (—) or en dashes (–). Use a period, comma, or a new sentence instead
- Every word must count - no fluff

Example format:
HOOK:
[Attention-grabbing opening...]

PROBLEM:
[Pain point...]

SOLUTION:
[Value delivery...]

CTA:
[Call to action...]

Write the complete script now:"""

        else:  # linkedin
            if content_classification and content_classification.get('templateType'):
                template_type = content_classification['templateType']
                template_info = CLASSIFICATION_STRUCTURES.get(template_type, {})
                template_name = template_info.get('name', template_type)
                structure_text = f"CONTENT TYPE: {template_name}\n"
            else:
                structure_text = ""

            linkedin_lang_instruction = f"\nOUTPUT LANGUAGE: Write the entire post in {output_language}.\n" if output_language and output_language != "en" else ""

            prompt = f"""Write a LinkedIn post.

TOPIC: {topic}
{linkedin_lang_instruction}
{voice_instruction}
{format_instruction}
{hook_instruction}
{f"ADDITIONAL CONTEXT: {context}" if context else ""}
{story_instruction}
{structure_text}

POST DIRECTION:
- Write like a thoughtful founder/operator sharing a useful point
- Make the first line specific and grounded, not clickbait
- Include one concrete example, observation, or detail
- Keep the post practical and opinionated without sounding preachy
- Avoid cringe LinkedIn tropes: "I was today years old", "Agree?", fake vulnerability, hustle porn, broetry, and engagement bait
- Use short paragraphs for readability, but do not force every sentence onto its own line
- End with a soft CTA only if it feels natural

OUTPUT FORMAT - CRITICAL:
- Write ONLY the LinkedIn post copy
- 120-220 words
- No section headers
- No markdown formatting
- No hashtags unless they are genuinely useful
- No word count
- Never use em dashes (—) or en dashes (–). Use a period, comma, or a new sentence instead

Write the complete LinkedIn post now:"""

        if include_title:
            from script_title import script_title_instruction, split_script_title
            prompt += script_title_instruction(mode, output_language)

        model = os.getenv("ANTHROPIC_MODEL", "claude-sonnet-4-6")
        response = client.messages.create(
            model=model,
            max_tokens=4000,
            messages=[{"role": "user", "content": prompt}]
        )
        
        raw_script = response.content[0].text.strip()
        title, raw_script = split_script_title(raw_script) if include_title else (None, raw_script)
        script_text = sanitize_script_copy(raw_script)
        
        return {
            "script": script_text,
            **({"title": title} if title else {}),
            "mode": mode,
            "topic": topic,
            "word_count": len(script_text.split()),
            "generated_at": dt.now().isoformat(),
        }
            
    except Exception as e:
        print(f"Claude script generation error: {e}")
        return {"error": format_claude_error(e)}


async def edit_script(current_script: str, edit_instruction: str, target_section: str = None, brand_voice: str = None, output_language: str = "en") -> dict:
    """Apply targeted edits to a script using Claude, preserving unchanged sections."""
    api_key = os.getenv("ANTHROPIC_API_KEY")
    if not api_key:
        return {"error": "API key not configured"}

    try:
        import anthropic

        client = anthropic.Anthropic(api_key=api_key)

        voice_note = ""
        if brand_voice:
            voice_note = f"\nThe script should maintain this brand voice: {brand_voice}\n"

        section_rule = ""
        if target_section:
            section_rule = f"""
TARGETED SECTION: {target_section}
You MUST only edit the "{target_section}" section. Every other section must be copied VERBATIM — character for character, word for word. Do not change a single word outside the {target_section} section.
"""

        edit_lang = f"\n- The edited script must be written in {output_language}." if output_language and output_language != "en" else ""
        
        prompt = f"""You are a script editor. You will receive a video script and an edit instruction.

CRITICAL RULES:
- Make ONLY the changes requested. Do NOT rewrite sections that weren't mentioned.
- Preserve the exact structure, section headers, and flow of the original script.
- If the user asks to change tone/style, apply it to the relevant parts while keeping the same points and structure.
- Every section NOT being edited must be copied VERBATIM — do not rephrase, reword, or reorganize them.
- Output the COMPLETE script with edits applied, keeping the same format as the original.
- Never use em dashes (—) or en dashes (–). Use a period, comma, or a new sentence instead.
- Do NOT add any commentary, explanations, or notes. Just output the edited script.{edit_lang}
{section_rule}{voice_note}
CURRENT SCRIPT:
{current_script}

EDIT INSTRUCTION:
{edit_instruction}

Output the edited script now:"""

        model = os.getenv("ANTHROPIC_MODEL", "claude-sonnet-4-6")
        response = client.messages.create(
            model=model,
            max_tokens=4000,
            messages=[{"role": "user", "content": prompt}]
        )

        edited_script = sanitize_script_copy(response.content[0].text.strip())

        return {
            "script": edited_script,
            "edit_instruction": edit_instruction,
            "edited_at": dt.now().isoformat(),
        }

    except Exception as e:
        print(f"Claude script edit error: {e}")
        return {"error": format_claude_error(e)}


