@app.post("/discover")
async def discover_accounts(request: DiscoverRequest, _: bool = Depends(verify_api_key)):
    """Discover Instagram accounts by niche."""
    apify_token = os.getenv("APIFY_API_TOKEN")
    if not apify_token:
        return {"error": "APIFY_API_TOKEN not configured", "accounts": []}
    
    try:
        from apify_client import ApifyClient
        client = ApifyClient(apify_token)
        
        all_accounts = []
        
        for niche in request.niches:
            run = client.actor("apify/instagram-search-scraper").call(
                run_input={
                    "search": niche,
                    "searchType": "user",
                    "resultsLimit": min(request.limit, 50),
                },
                timeout_secs=120
            )
            
            items = list(client.dataset(run["defaultDatasetId"]).iterate_items())
            for item in items:
                all_accounts.append({
                    "username": item.get("username"),
                    "fullName": item.get("fullName"),
                    "biography": item.get("biography"),
                    "followersCount": item.get("followersCount", 0),
                    "followingCount": item.get("followingCount", 0),
                    "postsCount": item.get("postsCount", 0),
                    "profilePicUrl": item.get("profilePicUrl"),
                    "isVerified": item.get("isVerified", False),
                    "niche": niche,
                })
        
        return {"accounts": all_accounts}
        
    except Exception as e:
        return {"error": str(e), "accounts": []}


