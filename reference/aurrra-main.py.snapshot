# ============================================
# VOICE & AVATAR ENDPOINTS
# ============================================

ELEVENLABS_API_URL = "https://api.elevenlabs.io/v1"
HEYGEN_API_URL = "https://api.heygen.com/v2"
HEYGEN_API_V3_URL = "https://api.heygen.com/v3"

# In-memory job store for voice/avatar generation (local worker cache).
# Supabase workflow_runs is the source of truth across workers.
voice_avatar_jobs: dict = {}


def _supabase_update_workflow_run(workflow_run_id: str, updates: dict):
    """Write job state directly to Supabase workflow_runs table via REST API.
    Used by the webhook handler to persist state even when the job lives on
    a different uvicorn worker's in-memory dict."""
    sb_url = os.getenv("SUPABASE_URL") or os.getenv("NEXT_PUBLIC_SUPABASE_URL")
    sb_key = os.getenv("SUPABASE_SERVICE_ROLE_KEY")
    if not sb_url or not sb_key or not workflow_run_id:
        return
    try:
        requests.patch(
            f"{sb_url}/rest/v1/workflow_runs?id=eq.{workflow_run_id}",
            headers={
                "apikey": sb_key,
                "Authorization": f"Bearer {sb_key}",
                "Content-Type": "application/json",
                "Prefer": "return=minimal",
            },
            json=updates,
            timeout=10,
        )
    except Exception as e:
        print(f"⚠ Failed to update workflow_run {workflow_run_id}: {e}")

class VoiceAvatarRequest(BaseModel):
    script: str
    voice_id: Optional[str] = None
    heygen_voice_id: Optional[str] = None
    heygen_voice_speed: Optional[float] = 1.0
    heygen_voice_volume: Optional[float] = 1.0
    avatar_id: Optional[str] = None
    voice_only: bool = False
    avatar_only: bool = False
    aspect_ratio: str = "9:16"
    heygen_access_token: Optional[str] = None
    heygen_api_key: Optional[str] = None
    status_callback_url: Optional[str] = None
    external_job_id: Optional[str] = None

class VoiceAvatarJobResponse(BaseModel):
    job_id: str
    status: str
    message: str

class VoiceAvatarStatusResponse(BaseModel):
    job_id: str
    status: str  # "pending", "running", "completed", "failed"
    progress: int  # 0-100
    message: str
    voiceover_url: Optional[str] = None
    avatar_video_url: Optional[str] = None
    error: Optional[str] = None
    created_at: str
    completed_at: Optional[str] = None


def sync_voice_avatar_status(job: dict):
    """Push job status to Next.js when callback URL is provided."""
    callback_url = job.get("request", {}).get("status_callback_url")
    if not callback_url:
        return

    payload = {
        "job_id": job.get("request", {}).get("external_job_id") or job.get("job_id"),
        "python_job_id": job.get("job_id"),
        "status": job.get("status"),
        "progress": job.get("progress", 0),
        "message": job.get("message"),
        "voiceover_url": job.get("voiceover_url"),
        "avatar_video_url": job.get("avatar_video_url"),
        "heygen_video_id": job.get("heygen_video_id"),
        "error": job.get("error"),
        "created_at": job.get("created_at"),
        "completed_at": job.get("completed_at"),
    }

    try:
        requests.patch(callback_url, json=payload, timeout=10)
    except Exception as e:
        print(f"⚠ Failed to sync voice/avatar status: {e}")


class DiscoverRequest(BaseModel):
    niches: list[str]
    limit: int = 50


@app.get("/voices")
async def list_voices(_: bool = Depends(verify_api_key)):
    """List available ElevenLabs voices."""
    api_key = os.getenv("ELEVENLABS_API_KEY")
    if not api_key:
        return {"error": "ELEVENLABS_API_KEY not configured", "voices": []}
    
    try:
        response = requests.get(
            f"{ELEVENLABS_API_URL}/voices",
            headers={"xi-api-key": api_key},
            timeout=30,
        )
        
        if response.status_code != 200:
            return {"error": f"API error: {response.text}", "voices": []}
        
        voices = response.json().get("voices", [])
        return {
            "voices": [
                {
                    "voice_id": v["voice_id"],
                    "name": v["name"],
                    "category": v.get("category", "unknown"),
                }
                for v in voices
            ]
        }
    except Exception as e:
        return {"error": str(e), "voices": []}


@app.get("/avatars")
async def list_avatars(_: bool = Depends(verify_api_key)):
    """List available HeyGen avatars."""
    api_key = os.getenv("HEYGEN_API_KEY")
    if not api_key:
        return {"error": "HEYGEN_API_KEY not configured", "avatars": []}
    
    try:
        response = requests.get(
            f"{HEYGEN_API_URL}/avatars",
            headers={"X-Api-Key": api_key},
            timeout=30,
        )
        
        if response.status_code != 200:
            return {"error": f"API error: {response.text}", "avatars": []}
        
        data = response.json().get("data", {})
        avatars = data.get("avatars", [])
        
        return {
            "avatars": [
                {
                    "avatar_id": a["avatar_id"],
                    "name": a.get("avatar_name", "Unknown"),
                    "gender": a.get("gender", "unknown"),
                }
                for a in avatars
            ]
        }
    except Exception as e:
        return {"error": str(e), "avatars": []}


def run_voice_avatar_job(job_id: str, request_data: dict):
    """Background worker for voice/avatar generation."""
    import time
    import base64
    from datetime import datetime
    
    job = voice_avatar_jobs.get(job_id)
    if not job:
        return
    
    job["status"] = "running"
    job["message"] = "Starting generation..."
    
    try:
        heygen_access_token = request_data.get("heygen_access_token")
        heygen_api_key_param = request_data.get("heygen_api_key")
        heygen_key = heygen_api_key_param or os.getenv("HEYGEN_API_KEY")
        heygen_headers = {"Content-Type": "application/json"}

        if heygen_access_token:
            heygen_headers["Authorization"] = f"Bearer {heygen_access_token}"
        elif heygen_key:
            heygen_headers["X-Api-Key"] = heygen_key

        # Generate voiceover with HeyGen when using HeyGen voices without an avatar.
        use_heygen_speech = request_data.get("voice_only") and request_data.get("heygen_voice_id")
        if use_heygen_speech:
            if not (heygen_access_token or heygen_key):
                job["error"] = "HeyGen auth not configured"
                job["status"] = "failed"
                sync_voice_avatar_status(job)
                return

            job["message"] = "Generating voiceover with HeyGen..."
            job["progress"] = 10
            sync_voice_avatar_status(job)

            response = requests.post(
                f"{HEYGEN_API_V3_URL}/voices/speech",
                headers=heygen_headers,
                json={
                    "text": request_data["script"],
                    "voice_id": request_data.get("heygen_voice_id"),
                    "speed": request_data.get("heygen_voice_speed", 1.0),
                },
                timeout=120,
            )

            if response.status_code in (200, 201):
                speech_data = response.json().get("data", {})
                audio_url = (
                    speech_data.get("audio_url")
                    or speech_data.get("url")
                    or speech_data.get("audio")
                    or speech_data.get("audio_file_url")
                )
                if not audio_url:
                    job["error"] = "HeyGen speech completed without an audio URL"
                    job["status"] = "failed"
                    sync_voice_avatar_status(job)
                    return
                job["voiceover_url"] = audio_url
                job["progress"] = 100
                job["message"] = "Voiceover complete!"
                sync_voice_avatar_status(job)
            else:
                job["error"] = f"HeyGen speech error: {response.text}"
                job["status"] = "failed"
                sync_voice_avatar_status(job)
                return

        # Legacy fallback for ElevenLabs voices.
        use_elevenlabs = (
            not use_heygen_speech
            and
            not request_data.get("avatar_only")
            and request_data.get("voice_id")
            and request_data.get("voice_only")
        )
        if use_elevenlabs:
            job["message"] = "Generating voiceover with ElevenLabs..."
            job["progress"] = 10
            
            elevenlabs_key = os.getenv("ELEVENLABS_API_KEY")
            if not elevenlabs_key:
                job["error"] = "ELEVENLABS_API_KEY not configured"
                job["status"] = "failed"
                sync_voice_avatar_status(job)
                return
            
            voice_id = request_data.get("voice_id") or "21m00Tcm4TlvDq8ikWAM"
            
            response = requests.post(
                f"{ELEVENLABS_API_URL}/text-to-speech/{voice_id}",
                headers={
                    "xi-api-key": elevenlabs_key,
                    "Content-Type": "application/json",
                },
                json={
                    "text": request_data["script"],
                    "model_id": "eleven_turbo_v2_5",
                    "voice_settings": {
                        "stability": 0.5,
                        "similarity_boost": 0.75,
                    }
                },
                timeout=120,
            )
            
            if response.status_code == 200:
                audio_base64 = base64.b64encode(response.content).decode()
                job["voiceover_url"] = f"data:audio/mpeg;base64,{audio_base64}"
                job["progress"] = 30
                job["message"] = "Voiceover complete!"
                sync_voice_avatar_status(job)
            else:
                job["error"] = f"ElevenLabs error: {response.text}"
                job["status"] = "failed"
                sync_voice_avatar_status(job)
                return
        
        # Generate avatar video with HeyGen
        if not request_data.get("voice_only"):
            job["message"] = "Starting HeyGen avatar generation..."
            job["progress"] = 20 if not use_elevenlabs else 40
            sync_voice_avatar_status(job)

            if not (heygen_access_token or heygen_key):
                if request_data.get("avatar_only"):
                    job["error"] = "HeyGen auth not configured"
                    job["status"] = "failed"
                    sync_voice_avatar_status(job)
                    return

            if heygen_access_token or heygen_key:
                avatar_id = request_data.get("avatar_id") or "Kristin_pubblic_2_20240108"
                aspect_ratio = request_data.get("aspect_ratio", "9:16")
                
                # Build callback URL so HeyGen's webhook can reach us
                railway_domain = os.getenv("RAILWAY_PUBLIC_DOMAIN", "")
                webhook_url = f"https://{railway_domain}/webhooks/heygen" if railway_domain else None

                # Use the Supabase workflow_run ID as callback_id so the webhook
                # can write directly to Supabase even from a different worker.
                heygen_callback_id = request_data.get("external_job_id") or job_id

                payload = {
                    "video_inputs": [
                        {
                            "character": {
                                "type": "avatar",
                                "avatar_id": avatar_id,
                                "avatar_style": "normal",
                            },
                            "voice": {
                                "type": "text",
                                "input_text": request_data["script"],
                                "voice_id": request_data.get("heygen_voice_id") or "1bd001e7e50f421d891986aad5158bc8",
                                "speed": request_data.get("heygen_voice_speed", 1.0),
                            },
                            "background": {
                                "type": "color",
                                "value": "#ffffff",
                            }
                        }
                    ],
                    "dimension": {
                        "width": 720 if aspect_ratio == "9:16" else 1280,
                        "height": 1280 if aspect_ratio == "9:16" else 720,
                    },
                    "callback_id": heygen_callback_id,
                }
                if webhook_url:
                    payload["callback_url"] = webhook_url
                
                print(f"📤 Submitting to HeyGen with callback_id={job_id}")
                
                response = requests.post(
                    f"{HEYGEN_API_URL}/video/generate",
                    headers=heygen_headers,
                    json=payload,
                    timeout=120,
                )
                
                if response.status_code == 200:
                    video_data = response.json().get("data", {})
                    video_id = video_data.get("video_id")
                    job["heygen_video_id"] = video_id
                    job["message"] = "HeyGen video queued, waiting for webhook callback..."
                    job["progress"] = 50
                    
                    print(f"✓ HeyGen accepted video, video_id={video_id}")
                    sync_voice_avatar_status(job)
                    
                    # Short polling loop as backup (webhook should arrive first)
                    # Only poll for 3 minutes - webhook should handle completion
                    for i in range(36):  # Max 3 minutes (36 * 5 seconds) as backup
                        # Check if webhook already completed the job
                        if job.get("status") == "completed" and job.get("avatar_video_url"):
                            print(f"✓ Job already completed via webhook, stopping polling")
                            break
                        if job.get("status") == "failed":
                            print(f"✓ Job already failed via webhook, stopping polling")
                            return
                            
                        time.sleep(5)
                        job["progress"] = min(50 + (i * 1.25), 95)  # Progress from 50 to 95
                        
                        status_resp = requests.get(
                            f"{HEYGEN_API_URL}/video_status.get",
                            headers={k: v for k, v in heygen_headers.items() if k != "Content-Type"},
                            params={"video_id": video_id},
                            # Kept short deliberately: this runs inside a 36-iteration
                            # poll loop, so a long timeout would stretch the loop far
                            # past the 3 minutes it is meant to cover.
                            timeout=30,
                        )
                        
                        if status_resp.status_code == 200:
                            status_data = status_resp.json().get("data", {})
                            heygen_status = status_data.get("status")
                            
                            if heygen_status == "completed":
                                job["avatar_video_url"] = status_data.get("video_url")
                                job["message"] = "Avatar video complete! (via polling)"
                                print(f"✓ Video completed via polling")
                                break
                            elif heygen_status == "failed":
                                error_info = status_data.get("error", {})
                                job["error"] = f"HeyGen failed: {error_info.get('message', 'Unknown error')}"
                                job["status"] = "failed"
                                print(f"✗ Video failed: {job['error']}")
                                sync_voice_avatar_status(job)
                                return
                            elif heygen_status == "processing":
                                job["message"] = f"HeyGen processing... ({i * 5}s, waiting for webhook)"
                            elif heygen_status == "pending":
                                job["message"] = f"HeyGen queued... ({i * 5}s, waiting for webhook)"
                    
                    # After backup polling, check if we got URL (from webhook or polling)
                    if not job.get("avatar_video_url") and job.get("status") != "failed":
                        # Webhook hasn't arrived yet, job will stay pending
                        # The webhook will complete it when it arrives
                        job["message"] = "Waiting for HeyGen to finish processing (webhook pending)..."
                        job["progress"] = 95
                        print(f"⏳ Backup polling finished, waiting for webhook for video_id={video_id}")
                else:
                    error_text = response.text
                    try:
                        error_json = response.json()
                        error_text = error_json.get("error", {}).get("message", response.text)
                    except:
                        pass
                    job["error"] = f"HeyGen error: {error_text}"
                    job["status"] = "failed"
                    sync_voice_avatar_status(job)
                    return
        
        # Only mark as completed if we have the output (URL)
        # Otherwise, webhook will complete the job
        if job.get("avatar_video_url") or job.get("voiceover_url"):
            job["status"] = "completed"
            job["progress"] = 100
            job["message"] = "Generation complete!"
            job["completed_at"] = datetime.utcnow().isoformat()
            print(f"✅ Job {job_id} completed with output")
            sync_voice_avatar_status(job)
        elif job.get("status") != "failed":
            # HeyGen job submitted, waiting for webhook
            job["status"] = "running"
            job["progress"] = 95
            job["message"] = "Waiting for HeyGen webhook callback..."
            print(f"⏳ Job {job_id} waiting for webhook callback")
            sync_voice_avatar_status(job)
        
    except Exception as e:
        job["error"] = f"Generation error: {str(e)}"
        job["status"] = "failed"
        print(f"❌ Job {job_id} error: {e}")
        sync_voice_avatar_status(job)


@app.post("/voice-avatar/start")
async def start_voice_avatar_job(request: VoiceAvatarRequest, background_tasks: BackgroundTasks, _: bool = Depends(verify_api_key)):
    """Start a voice/avatar generation job. Returns immediately with job ID."""
    import uuid
    from datetime import datetime
    
    job_id = str(uuid.uuid4())
    
    # Create job entry
    voice_avatar_jobs[job_id] = {
        "job_id": job_id,
        "status": "pending",
        "progress": 0,
        "message": "Job queued",
        "voiceover_url": None,
        "avatar_video_url": None,
        "error": None,
        "created_at": datetime.utcnow().isoformat(),
        "completed_at": None,
        "request": {
            "script": request.script,
            "voice_id": request.voice_id,
            "heygen_voice_id": request.heygen_voice_id,
            "heygen_voice_speed": request.heygen_voice_speed,
            "heygen_voice_volume": request.heygen_voice_volume,
            "avatar_id": request.avatar_id,
            "voice_only": request.voice_only,
            "avatar_only": request.avatar_only,
            "aspect_ratio": request.aspect_ratio,
            "heygen_access_token": request.heygen_access_token,
            "heygen_api_key": request.heygen_api_key,
            "status_callback_url": request.status_callback_url,
            "external_job_id": request.external_job_id,
        }
    }
    
    # Start background task
    background_tasks.add_task(run_voice_avatar_job, job_id, voice_avatar_jobs[job_id]["request"])
    
    return {
        "job_id": job_id,
        "status": "pending",
        "message": "Job started. Poll /voice-avatar/status/{job_id} for updates."
    }


@app.get("/voice-avatar/status/{job_id}")
async def get_voice_avatar_status(job_id: str, _: bool = Depends(verify_api_key)):
    """Get the status of a voice/avatar generation job."""
    job = voice_avatar_jobs.get(job_id)
    
    if not job:
        return {"error": "Job not found", "status": "not_found"}
    
    return {
        "job_id": job["job_id"],
        "status": job["status"],
        "progress": job["progress"],
        "message": job["message"],
        "voiceover_url": job["voiceover_url"],
        "avatar_video_url": job["avatar_video_url"],
        "error": job["error"],
        "created_at": job["created_at"],
        "completed_at": job["completed_at"],
    }


@app.get("/voice-avatar/jobs")
async def list_voice_avatar_jobs(_: bool = Depends(verify_api_key)):
    """List all voice/avatar jobs (recent first)."""
    jobs = list(voice_avatar_jobs.values())
    jobs.sort(key=lambda x: x["created_at"], reverse=True)
    return {"jobs": jobs[:50]}  # Return last 50 jobs


# HeyGen Webhook endpoint - receives callbacks when videos complete
@app.post("/webhooks/heygen")
async def heygen_webhook(request: Request):
    """
    Webhook endpoint for HeyGen callbacks.
    HeyGen will POST here when avatar videos complete or fail.
    Requires the configured callback secret before reading or updating a job.
    """
    from datetime import datetime
    secret = os.getenv("HEYGEN_WEBHOOK_SECRET") or os.getenv("PYTHON_SERVICE_SECRET")
    supplied = request.headers.get("x-heygen-webhook-secret") or request.headers.get("x-webhook-secret") or request.query_params.get("token")
    if not valid_secret(supplied, secret):
        raise HTTPException(status_code=401, detail="Unauthorized")

    try:
        payload = await request.json()
        event_type = payload.get("event_type")
        event_data = payload.get("event_data", {})
        
        print(f"🔔 HeyGen webhook received: {event_type}")
        print(f"   Event data: {event_data}")
        
        # callback_id is now the Supabase workflow_run ID (external_job_id)
        # so we can write directly to Supabase even from a different worker.
        callback_id = event_data.get("callback_id")
        video_id = event_data.get("video_id")
        
        if not callback_id:
            print(f"   ⚠️ No callback_id in webhook, trying to find job by video_id: {video_id}")
            for jid, j in voice_avatar_jobs.items():
                if j.get("heygen_video_id") == video_id:
                    callback_id = j.get("request", {}).get("external_job_id") or jid
                    print(f"   ✓ Found job by video_id, callback_id={callback_id}")
                    break

        if not callback_id:
            print(f"   ❌ Could not find job for video_id={video_id}")
            return {"status": "ok", "message": "Job not found, possibly expired"}

        # Try to update local in-memory dict (same-worker fast path)
        local_job = voice_avatar_jobs.get(callback_id)
        if not local_job:
            # callback_id is external_job_id; find by scanning the dict
            for jid, j in voice_avatar_jobs.items():
                if j.get("request", {}).get("external_job_id") == callback_id:
                    local_job = j
                    break

        now = datetime.utcnow().isoformat()

        if event_type == "avatar_video.success":
            video_url = event_data.get("url")
            gif_url = event_data.get("gif_download_url")

            if local_job:
                local_job["avatar_video_url"] = video_url
                local_job["gif_url"] = gif_url
                local_job["status"] = "completed"
                local_job["progress"] = 100
                local_job["message"] = "Avatar video complete! (via webhook)"
                local_job["completed_at"] = now
                sync_voice_avatar_status(local_job)

            # Always persist to Supabase (handles cross-worker case)
            _supabase_update_workflow_run(callback_id, {
                "status": "completed",
                "completed_at": now,
                "output_json": {
                    "avatarPath": video_url,
                    "gifUrl": gif_url,
                    "progress": 100,
                    "message": "Avatar video complete! (via webhook)",
                },
            })

            print(f"   ✅ Job {callback_id} completed via webhook!")
            print(f"   Video URL: {video_url[:80]}..." if video_url else "   No video URL")

        elif event_type == "avatar_video.fail":
            error_msg = event_data.get("msg", "Unknown error")

            if local_job:
                local_job["status"] = "failed"
                local_job["error"] = f"HeyGen failed: {error_msg}"
                local_job["message"] = f"Generation failed: {error_msg}"
                local_job["completed_at"] = now
                sync_voice_avatar_status(local_job)

            _supabase_update_workflow_run(callback_id, {
                "status": "failed",
                "completed_at": now,
                "error_message": f"HeyGen failed: {error_msg}",
            })

            print(f"   ❌ Job {callback_id} failed via webhook: {error_msg}")

        return {"status": "ok", "event_type": event_type, "job_id": callback_id}
        
    except Exception as e:
        print(f"   ❌ Webhook error: {e}")
        return {"status": "error", "message": str(e)}


@app.options("/webhooks/heygen")
async def heygen_webhook_options():
    """Handle OPTIONS request for HeyGen webhook validation (1-second timeout)."""
    return {"status": "ok"}


