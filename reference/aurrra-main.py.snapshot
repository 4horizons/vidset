class TestSupabaseRequest(BaseModel):
    supabase_url: Optional[str] = None
    supabase_key: Optional[str] = None


@app.post("/debug/test-supabase")
async def test_supabase_connection(request: TestSupabaseRequest, _: bool = Depends(verify_api_key)):
    """
    Debug endpoint to test Supabase connection.
    Call this to verify credentials are being passed correctly.
    """
    result = {
        "supabase_url_received": bool(request.supabase_url),
        "supabase_key_received": bool(request.supabase_key),
        "supabase_url_preview": request.supabase_url[:50] + "..." if request.supabase_url and len(request.supabase_url) > 50 else request.supabase_url,
    }
    
    if request.supabase_url and request.supabase_key:
        # Test listing buckets
        try:
            test_url = f"{request.supabase_url}/storage/v1/bucket"
            resp = requests.get(
                test_url,
                headers={"Authorization": f"Bearer {request.supabase_key}"},
                timeout=10
            )
            result["bucket_list_status"] = resp.status_code
            result["bucket_list_response"] = resp.text[:500] if resp.status_code != 200 else f"Found {len(resp.json())} buckets"
        except Exception as e:
            result["bucket_list_error"] = str(e)
    
    return result


