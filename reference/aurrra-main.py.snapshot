class VideoEditRequest(BaseModel):
    video_url: str  # URL to video file (from cloud storage)
    title: Optional[str] = None
    # Silence removal options
    silence_threshold_db: float = -35
    silence_min_duration: float = 0.5
    padding_ms: int = 50  # Padding around speech in ms
    # Processing options
    enhance_audio: bool = True
    detect_restarts: bool = False
    add_swivel: bool = False
    # Optional file URLs
    lut_path: Optional[str] = None
    bg_image: Optional[str] = None
    # Supabase storage config (for uploading processed video)
    supabase_url: Optional[str] = None
    supabase_key: Optional[str] = None
    output_bucket: str = "videos"
    output_folder: str = "processed"


async def get_face_pose_from_image(image_bytes: bytes) -> dict:
    """
    Extract yaw and pitch angles from a face image using Gemini vision.
    Replaces the previous MediaPipe/OpenCV approach to avoid numpy ABI issues.
    """
    import base64
    import json as _json

    from google import genai
    from google.genai import types

    api_key = os.getenv("NANO_BANANA_API_KEY") or os.getenv("GOOGLE_GENAI_API_KEY")
    if not api_key:
        return {"error": "GOOGLE_GENAI_API_KEY not configured"}

    client = genai.Client(api_key=api_key)

    b64 = base64.b64encode(image_bytes).decode()

    prompt = """Analyze this face photo and estimate the head pose angles.

Return ONLY a JSON object with these exact fields:
- "yaw": number in degrees (negative = looking left, positive = looking right, 0 = center)
- "pitch": number in degrees (positive = looking up, negative = looking down, 0 = level)
- "yaw_direction": one of "left", "right", or "center"
- "pitch_direction": one of "up", "down", or "level"

If no face is detected, return: {"error": "No face detected"}

Return ONLY the JSON, no markdown formatting."""

    try:
        response = client.models.generate_content(
            model="gemini-2.5-flash",
            contents=[
                types.Content(parts=[
                    types.Part.from_text(text=prompt),
                    types.Part.from_bytes(data=image_bytes, mime_type="image/jpeg"),
                ])
            ],
        )

        text = response.text.strip()
        if text.startswith("```"):
            text = text.split("\n", 1)[1] if "\n" in text else text[3:]
            text = text.rsplit("```", 1)[0].strip()

        result = _json.loads(text)

        if "error" in result:
            return result

        yaw = float(result.get("yaw", 0))
        pitch = float(result.get("pitch", 0))
        return {
            "yaw": round(yaw, 1),
            "pitch": round(pitch, 1),
            "yaw_direction": result.get("yaw_direction", "left" if yaw < -5 else "right" if yaw > 5 else "center"),
            "pitch_direction": result.get("pitch_direction", "up" if pitch > 5 else "down" if pitch < -5 else "level"),
        }
    except Exception as e:
        print(f"Gemini face pose error: {e}")
        return {"error": f"Face analysis failed: {str(e)}"}


@app.post("/analyze-photo")
async def analyze_photo_endpoint(request: AnalyzePhotoRequest, _: bool = Depends(verify_api_key)):
    """Analyze face direction in a photo."""
    try:
        import base64
        image_bytes = base64.b64decode(request.image_base64)
        result = await get_face_pose_from_image(image_bytes)
        return result
    except Exception as e:
        return {"error": str(e)}


@app.post("/thumbnail-capabilities")
async def thumbnail_capabilities(_: bool = Depends(verify_api_key)):
    return {"advancedVersion": 1, "styleReferenceVersion": 1, "creativeDirectionVersion": 1}


@app.post("/thumbnail")
async def generate_thumbnail_endpoint(request: ThumbnailRequest, _: bool = Depends(verify_api_key)):
    """Generate or edit a thumbnail."""
    try:
        from google import genai
        from google.genai import types
        import base64
        
        api_key = os.getenv("NANO_BANANA_API_KEY") or os.getenv("GOOGLE_GENAI_API_KEY")
        if not api_key:
            return {"error": "NANO_BANANA_API_KEY not configured", "thumbnails": []}
        
        client = genai.Client(api_key=api_key)
        
        # Model for original thumbnail rendering and identity-aware edits.
        IMAGE_MODEL = "gemini-3-pro-image-preview"
        
        from thumbnail_rendering import BRAND_DIRECTION, render_designed_thumbnail

        # Edit mode
        if request.edit_image_base64 and request.edit_prompt:
            image_bytes = base64.b64decode(request.edit_image_base64)
            
            response = client.models.generate_content(
                model=IMAGE_MODEL,
                contents=[
                    types.Content(
                        role="user",
                        parts=[
                            types.Part.from_bytes(data=image_bytes, mime_type="image/png"),
                            types.Part.from_text(text=f"Edit this thumbnail: {request.edit_prompt}. {BRAND_DIRECTION} Compose the output in {request.aspect_ratio} format."),
                        ],
                    )
                ],
                config=types.GenerateContentConfig(
                    response_modalities=["image", "text"],
                ),
            )
            
            thumbnails = []
            for part in response.candidates[0].content.parts:
                if hasattr(part, "inline_data") and part.inline_data:
                    thumbnails.append({
                        "base64": base64.b64encode(part.inline_data.data).decode(),
                        "mime_type": part.inline_data.mime_type,
                    })
            
            return {"thumbnails": thumbnails, "mode": "edit"}
        
        # Decode reference photos if provided
        reference_images = []
        if request.reference_photos:
            for ref_base64 in request.reference_photos:
                ref_bytes = base64.b64decode(ref_base64, validate=True)
                if not ref_bytes:
                    raise ValueError("Identity reference photo is empty")
                reference_images.append(ref_bytes)

        num_refs = len(reference_images)

        # Every variation receives the original source and the same brand/portrait direction.
        if request.concept_prompts:
            if len(request.concept_prompts) != request.variations or not 1 <= len(request.concept_prompts) <= 2:
                raise ValueError("Expected one concept per requested variation")
            thumbnails = [render_designed_thumbnail(client, types, IMAGE_MODEL, concept, reference_images,
                          request.style_reference_images or [], request.original_source, request.aspect_ratio)
                          for concept in request.concept_prompts]
            return {"thumbnails": thumbnails, "mode": "concepts", "reference_photos_used": num_refs}

        # Creative mode uses the same fresh portrait and brand-specific prompting.
        if request.creative_prompt:
            thumbnails = [render_designed_thumbnail(client, types, IMAGE_MODEL,
                          request.creative_prompt + f"\nProfessional YouTube thumbnail quality, clear hierarchy and high contrast. Variation {i+1} of {request.variations}.",
                          reference_images, [], request.original_source, request.aspect_ratio)
                          for i in range(request.variations)]
            return {"thumbnails": thumbnails, "mode": "creative", "reference_photos_used": num_refs}

        # Recreate mode — requires a source image
        source_image = None
        if request.source_image_base64:
            source_image = base64.b64decode(request.source_image_base64)
        elif request.youtube_url:
            video_id_match = re.search(r'(?:v=|youtu\.be/|shorts/)([a-zA-Z0-9_-]{11})', request.youtube_url)
            if video_id_match:
                video_id = video_id_match.group(1)
                for quality in ["maxresdefault", "sddefault", "hqdefault", "mqdefault"]:
                    thumb_url = f"https://img.youtube.com/vi/{video_id}/{quality}.jpg"
                    resp = safe_media_get(thumb_url, timeout=10)
                    if resp.status_code == 200 and len(resp.content) > 1000:
                        source_image = resp.content
                        break
        
        if not source_image:
            return {"error": "No source image provided", "thumbnails": []}
        
        face_pose = await get_face_pose_from_image(source_image)
        
        if num_refs > 0:
            ref_list = " and ".join([f"IMAGE {i+1}" for i in range(num_refs)])
            prompt = f"""{ref_list}: Reference photo(s) of the person's face — use ONLY for facial identity (features, bone structure, skin tone).
IMAGE {num_refs + 1}: The original thumbnail to recreate.

TASK: Replace ONLY the face in the thumbnail with the person from the reference photo(s).

CRITICAL RULES:
- The output must be a 100% exact duplicate of the thumbnail. Keep every single pixel identical outside the face region.
- Do NOT paste the reference photo directly. Adapt the face to match the thumbnail's lighting, color grading, shadows, and art style.
- The swapped face must look like it was originally part of the thumbnail — same lighting direction, same color temperature, same contrast level.
- Preserve the exact pose, expression style, and head angle from the original thumbnail.
- Do NOT change the background, text, graphics, composition, or any non-face element.

Output in {request.aspect_ratio} format.
"""
            if "yaw" in face_pose:
                prompt += f"\nNote: The original face is looking {face_pose['yaw_direction']} ({face_pose['yaw']}° yaw). Match this pose direction."
            
            if request.custom_prompt:
                prompt += f"\n\nADDITIONAL INSTRUCTIONS:\n{request.custom_prompt}"
        else:
            prompt = f"""Recreate this thumbnail with these requirements:
1. Keep the same general composition and text placement
2. Make it eye-catching and click-worthy
3. Use vibrant colors and high contrast
4. Maintain professional quality in {request.aspect_ratio} format
"""
            if "yaw" in face_pose:
                prompt += f"\nNote: The face is looking {face_pose['yaw_direction']} ({face_pose['yaw']}° yaw)"
            
            if request.custom_prompt:
                prompt += f"\n\nADDITIONAL INSTRUCTIONS:\n{request.custom_prompt}"
        
        thumbnails = []
        for i in range(request.variations):
            parts = []
            for ref_bytes in reference_images:
                parts.append(types.Part.from_bytes(data=ref_bytes, mime_type="image/jpeg"))
            parts.append(types.Part.from_bytes(data=source_image, mime_type="image/jpeg"))
            if request.custom_prompt:
                parts.append(types.Part.from_text(text=BRAND_DIRECTION))
            parts.append(types.Part.from_text(text=prompt + f"\n\nVariation {i+1} of {request.variations}"))
            
            response = client.models.generate_content(
                model=IMAGE_MODEL,
                contents=[types.Content(role="user", parts=parts)],
                config=types.GenerateContentConfig(response_modalities=["image", "text"]),
            )
            
            for part in response.candidates[0].content.parts:
                if hasattr(part, "inline_data") and part.inline_data:
                    thumbnails.append({
                        "base64": base64.b64encode(part.inline_data.data).decode(),
                        "mime_type": part.inline_data.mime_type,
                    })
        
        return {
            "thumbnails": thumbnails,
            "face_pose": face_pose,
            "mode": "generate",
            "reference_photos_used": num_refs,
        }
        
    except Exception as e:
        return {"error": str(e), "thumbnails": []}


async def _run_thumbnail_and_save(job_id: str, request: ThumbnailAsyncRequest):
    """Background task: generate thumbnails, upload to Supabase Storage, update workflow_runs."""
    import base64 as b64
    import hashlib

    sb_url = os.getenv("SUPABASE_URL") or os.getenv("NEXT_PUBLIC_SUPABASE_URL")
    sb_key = os.getenv("SUPABASE_SERVICE_ROLE_KEY")

    if not sb_url or not sb_key:
        # See the matching note in _run_analysis_and_save: unreachable via the
        # endpoint, unrecoverable from here, so make it loud instead of silent.
        report_error(
            f"[thumbnail-async] Supabase credentials missing for job {job_id}; "
            "job stranded and credits not refunded"
        )
        return

    headers = {
        "apikey": sb_key,
        "Authorization": f"Bearer {sb_key}",
        "Content-Type": "application/json",
        "Prefer": "return=minimal",
    }
    table_url = f"{sb_url}/rest/v1/workflow_runs"

    def update_logs(logs: str):
        try:
            requests.patch(
                f"{table_url}?id=eq.{job_id}",
                headers=headers,
                json={"logs": logs},
                timeout=10,
            )
        except Exception as e:
            print(f"[thumbnail-async] Log update error: {e}")

    all_logs = ""
    def log(msg: str):
        nonlocal all_logs
        all_logs += msg + "\n"
        update_logs(all_logs)
        print(f"[thumbnail-async] [{job_id[:8]}] {msg}")

    try:
        inner_req = ThumbnailRequest(
            aspect_ratio=request.aspect_ratio,
            youtube_url=request.youtube_url,
            source_image_base64=request.source_image_base64,
            creative_prompt=request.creative_prompt,
            concept_prompts=request.concept_prompts,
            original_source=request.original_source,
            style_reference_images=request.style_reference_images,
            variations=request.variations,
            custom_prompt=request.custom_prompt,
            reference_photos=request.reference_photos,
            edit_image_base64=request.edit_image_base64,
            edit_prompt=request.edit_prompt,
        )

        is_edit = bool(request.edit_image_base64 and request.edit_prompt)
        log("✏️ Editing thumbnail..." if is_edit else f"🖼️ Generating {request.variations} thumbnail(s)...")
        if not is_edit:
            log(f"📷 Received {len(request.reference_photos or [])} identity reference photo(s)")

        log("🤖 Calling AI service...")
        # The image SDK is blocking. Keep the API responsive to
        # status requests and concurrent edits while this background job renders.
        import asyncio
        result = await asyncio.to_thread(lambda: asyncio.run(generate_thumbnail_endpoint(inner_req, _=True)))

        if isinstance(result, dict) and result.get("error"):
            raise Exception(result["error"])

        raw_thumbnails = result.get("thumbnails", []) if isinstance(result, dict) else []
        face_pose = result.get("face_pose") if isinstance(result, dict) else None
        reference_photos_used = result.get("reference_photos_used", 0) if isinstance(result, dict) else 0
        if not is_edit:
            log(f"📷 Used {reference_photos_used} identity reference photo(s) per variation")
        log(f"✅ Generated {len(raw_thumbnails)} thumbnail(s)")

        if face_pose and not face_pose.get("error"):
            log(f"🎯 Face direction: {face_pose.get('yaw_direction')} ({face_pose.get('yaw')}°)")

        log("📤 Uploading to storage...")
        uploaded = []
        bucket = "thumbnails"
        folder = "generated"

        for i, thumb_data in enumerate(raw_thumbnails):
            b64_str = thumb_data if isinstance(thumb_data, str) else thumb_data.get("base64", "")
            if not b64_str:
                log(f"  ✗ Thumbnail {i+1} has no data")
                continue

            img_bytes = b64.b64decode(b64_str)
            ts = int(dt.now().timestamp() * 1000)
            h = hashlib.md5(f"{job_id}-{i}-{ts}".encode()).hexdigest()[:8]
            storage_path = f"{folder}/{job_id}/{ts}_{h}_{i}.png"

            upload_url = f"{sb_url}/storage/v1/object/{bucket}/{storage_path}"
            upload_resp = requests.post(
                upload_url,
                headers={
                    "Authorization": f"Bearer {sb_key}",
                    "Content-Type": "image/png",
                    "x-upsert": "true",
                },
                data=img_bytes,
                timeout=30,
            )

            if upload_resp.status_code in [200, 201]:
                public_url = f"{sb_url}/storage/v1/object/public/{bucket}/{storage_path}"

                asset_resp = requests.post(
                    f"{sb_url}/rest/v1/assets",
                    headers={**headers, "Prefer": "return=representation"},
                    json={
                        "kind": "thumbnail",
                        "storage_path": storage_path,
                        "public_url": public_url,
                        "metadata_json": {
                            "variation": i + 1,
                            "facePose": face_pose,
                            "sourceUrl": request.youtube_url,
                            "mode": "edit" if is_edit else "generate",
                            "jobId": job_id,
                        },
                        "status": "completed",
                    },
                    timeout=10,
                )

                asset_id = None
                if asset_resp.status_code in [200, 201]:
                    try:
                        asset_data = asset_resp.json()
                        asset_id = asset_data[0]["id"] if isinstance(asset_data, list) else asset_data.get("id")
                    except Exception:
                        pass

                uploaded.append({
                    "url": public_url,
                    "storagePath": storage_path,
                    "assetId": asset_id,
                })
                log(f"  ✓ Thumbnail {i+1} uploaded")
            else:
                log(f"  ✗ Thumbnail {i+1} upload failed ({upload_resp.status_code})")

        requests.patch(
            f"{table_url}?id=eq.{job_id}",
            headers=headers,
            json={
                "status": "completed",
                "output_json": {
                    "thumbnails": uploaded,
                    "facePose": face_pose,
                    "totalGenerated": len(raw_thumbnails),
                    "totalUploaded": len(uploaded),
                    "referencePhotosUsed": reference_photos_used,
                },
                "completed_at": dt.now().isoformat(),
                "logs": all_logs + f"🎉 Complete! {len(uploaded)} thumbnails saved.\n",
            },
            timeout=15,
        )
        print(f"[thumbnail-async] SUCCESS: job {job_id} — {len(uploaded)} thumbnails")

    except Exception as e:
        error_msg = str(e)
        print(f"[thumbnail-async] FAILED: job {job_id} — {error_msg}")

        try:
            requests.patch(
                f"{table_url}?id=eq.{job_id}",
                headers=headers,
                json={
                    "status": "failed",
                    "error_message": error_msg,
                    "completed_at": dt.now().isoformat(),
                    "logs": all_logs + f"❌ Error: {error_msg}\n",
                },
                timeout=10,
            )
        except Exception:
            pass

        _refund_credits_once(
            sb_url,
            headers,
            "[thumbnail-async]",
            user_id=request.user_id,
            credit_cost=request.credit_cost,
            reference_id=request.credit_reference_id,
        )


@app.post("/thumbnail-async")
async def generate_thumbnail_async_endpoint(
    request: ThumbnailAsyncRequest,
    background_tasks: BackgroundTasks,
    _: bool = Depends(verify_api_key),
):
    """Fire-and-forget thumbnail generation. Results written to Supabase."""
    _require_supabase("[thumbnail-async]", request.job_id)
    print(f"[thumbnail-async] Accepted job {request.job_id}")
    background_tasks.add_task(_run_thumbnail_and_save, request.job_id, request)
    return {"status": "accepted", "job_id": request.job_id}


# ============================================
# TRANSCRIPTION
# ============================================

class TranscribeRequest(BaseModel):
    video_url: str

@app.post("/transcribe")
async def transcribe_endpoint(request: TranscribeRequest, _: bool = Depends(verify_api_key)):
    """
    Transcribe a video/audio file and return word-level timestamps.
    Uses AssemblyAI if ASSEMBLYAI_API_KEY is set, otherwise falls back to Whisper.

    Returns: { words: [{ text, start, end, confidence }] }
    """
    import tempfile
    import subprocess

    tmp_dir = tempfile.mkdtemp(prefix="transcribe_")
    try:
        # Download the media file
        media_path = os.path.join(tmp_dir, "input_media")
        print(f"📥 Downloading media from {request.video_url[:80]}...")
        resp = safe_media_get(request.video_url, stream=True, timeout=120)
        resp.raise_for_status()
        with open(media_path, "wb") as f:
            for chunk in resp.iter_content(chunk_size=8192):
                f.write(chunk)

        # Extract audio as WAV (required by both AssemblyAI and Whisper)
        audio_path = os.path.join(tmp_dir, "audio.wav")
        print("🔊 Extracting audio...")
        subprocess.run(
            ["ffmpeg", "-y", "-i", media_path, "-vn", "-acodec", "pcm_s16le",
             "-ar", "16000", "-ac", "1", audio_path],
            capture_output=True, check=True, timeout=300,
        )

        # Transcribe using the best available method
        from scripts.jump_cut_vad_parallel import transcribe_audio
        raw_words = transcribe_audio(audio_path)

        # Normalize to our API shape: { text, start, end, confidence }
        words = []
        for w in raw_words:
            words.append({
                "text": w.get("word", w.get("text", "")),
                "start": round(w["start"], 3),
                "end": round(w["end"], 3),
                "confidence": w.get("confidence", 1.0),
            })

        print(f"✅ Transcription complete: {len(words)} words")
        return {"words": words}

    except subprocess.CalledProcessError as e:
        stderr = (e.stderr or b"").decode(errors="replace")
        raise HTTPException(status_code=500, detail=f"FFmpeg error: {stderr[-500:]}")
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
    finally:
        import shutil
        shutil.rmtree(tmp_dir, ignore_errors=True)


# ============================================
# VIDEO EDITING
# ============================================

@app.post("/video-edit")
async def video_edit_endpoint(request: VideoEditRequest, _: bool = Depends(verify_api_key)):
    """
    Full-featured video editor using the battle-tested execution scripts:
    - jump_cut_vad_parallel.py: Silence removal (Silero VAD), audio enhancement, restart detection
    - insert_3d_transition.py: 3D swivel intro using Remotion
    
    These are the same scripts that work locally, now deployed to production.
    
    Returns a URL to the processed video (uploaded to Supabase Storage).
    """
    import tempfile
    import subprocess
    import shutil
    import time
    
    import sys
    import gc
    SCRIPTS_DIR = os.path.join(os.path.dirname(__file__), "scripts")
    
    def get_memory_mb():
        """Get current memory usage in MB"""
        try:
            import resource
            mem = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
            # On Linux, ru_maxrss is in KB; on macOS it's in bytes
            if sys.platform == 'darwin':
                return mem / 1024 / 1024
            else:
                return mem / 1024  # Linux reports in KB
        except:
            return -1
    
    def log_step(step: str, include_memory: bool = False):
        """Helper for consistent logging - flush immediately for Railway logs"""
        if include_memory:
            mem_mb = get_memory_mb()
            print(f"[video-edit] {step} [MEM: {mem_mb:.0f}MB]", flush=True)
        else:
            print(f"[video-edit] {step}", flush=True)
        sys.stdout.flush()
    
    try:
        log_step(f"Starting video edit for: {request.video_url[:100]}...")
        
        # ============================================
        # STEP 0: Download input video
        # ============================================
        log_step("Downloading input video...")
        response = safe_media_get(request.video_url, stream=True, timeout=120)
        if response.status_code != 200:
            return {"error": f"Could not download video: {response.status_code}"}
        
        with tempfile.TemporaryDirectory() as tmpdir:
            input_path = os.path.join(tmpdir, "input.mp4")
            jump_cut_output = os.path.join(tmpdir, "jump_cut_output.mp4")
            final_output = os.path.join(tmpdir, "output.mp4")
            
            # Save input video
            total_size = 0
            with open(input_path, 'wb') as f:
                for chunk in response.iter_content(chunk_size=8192):
                    f.write(chunk)
                    total_size += len(chunk)
            
            log_step(f"Downloaded {total_size / 1024 / 1024:.1f} MB", include_memory=True)
            
            # Get original duration
            probe_cmd = ["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "json", input_path]
            probe_result = subprocess.run(probe_cmd, capture_output=True, text=True, timeout=30)
            original_duration = float(json.loads(probe_result.stdout)["format"]["duration"])
            log_step(f"Original duration: {original_duration:.1f}s")
            
            # Download optional files
            lut_path_local = None
            if request.lut_path:
                log_step("Downloading LUT file...")
                lut_response = safe_media_get(request.lut_path, timeout=30)
                if lut_response.status_code == 200:
                    lut_path_local = os.path.join(tmpdir, "input.cube")
                    with open(lut_path_local, 'wb') as f:
                        f.write(lut_response.content)
            
            bg_image_local = None
            if request.bg_image:
                log_step("Downloading background image...")
                bg_response = safe_media_get(request.bg_image, timeout=30)
                if bg_response.status_code == 200:
                    ext = request.bg_image.split('.')[-1] or 'png'
                    bg_image_local = os.path.join(tmpdir, f"bg_image.{ext}")
                    with open(bg_image_local, 'wb') as f:
                        f.write(bg_response.content)
            
            features_applied = {
                "silence_removal": True,
                "audio_enhancement": request.enhance_audio,
                "detect_restarts": False,
                "lut_grading": lut_path_local is not None,
                "add_swivel": False,
            }
            
            processing_logs = []
            
            # ============================================
            # STEP 1: Run jump_cut_vad_parallel.py
            # ============================================
            log_step("Running jump_cut_vad_parallel.py...")
            start_time = time.time()
            
            jump_cut_script = os.path.join(SCRIPTS_DIR, "jump_cut_vad_parallel.py")
            
            # Set thread limits for containerized environment
            env = os.environ.copy()
            env["OMP_NUM_THREADS"] = "2"
            env["MKL_NUM_THREADS"] = "2"
            env["OPENBLAS_NUM_THREADS"] = "2"
            env["NUMEXPR_NUM_THREADS"] = "2"
            
            # Pass AssemblyAI API key if available (for faster transcription)
            assemblyai_key = os.environ.get("ASSEMBLYAI_API_KEY")
            if assemblyai_key:
                env["ASSEMBLYAI_API_KEY"] = assemblyai_key
                log_step("AssemblyAI API key detected - will use cloud transcription (10x faster)")
            else:
                log_step("No AssemblyAI key - will use local Whisper for transcription")
            
            cmd = [
                "python", jump_cut_script,
                input_path, jump_cut_output,
                "--min-silence", str(request.silence_min_duration),
                "--padding", str(request.padding_ms),
                "--workers", "1",  # Sequential encoding - Railway OOM kills parallel FFmpeg processes
            ]
            
            if request.enhance_audio:
                cmd.append("--enhance-audio")
                cmd.append("--light-audio")  # Use lighter audio filters to reduce memory
            
            if request.detect_restarts:
                cmd.append("--detect-restarts")
            
            if lut_path_local:
                cmd.extend(["--apply-lut", lut_path_local])
            
            log_step(f"Command: {' '.join(cmd)}")
            
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=600, env=env)
            
            # Log output immediately for debugging
            log_step(f"Script stdout (last 2000 chars):")
            if result.stdout:
                for line in result.stdout[-2000:].split('\n'):
                    if line.strip():
                        log_step(f"  > {line}")
            
            if result.stderr:
                log_step(f"Script stderr (last 500 chars):")
                for line in result.stderr[-500:].split('\n'):
                    if line.strip():
                        log_step(f"  ! {line}")
            
            processing_logs.append(f"jump_cut stdout: {result.stdout[-1000:] if result.stdout else 'none'}")
            processing_logs.append(f"jump_cut stderr: {result.stderr[-1000:] if result.stderr else 'none'}")
            
            elapsed = time.time() - start_time
            log_step(f"jump_cut completed in {elapsed:.1f}s (exit code: {result.returncode})", include_memory=True)
            
            # Force garbage collection to free memory before upload
            gc.collect()
            
            # Debug: Log what we're about to do next
            log_step(f"DEBUG: Checking output file exists at {jump_cut_output}")
            log_step(f"DEBUG: Supabase URL provided: {bool(request.supabase_url)}")
            log_step(f"DEBUG: Supabase key provided: {bool(request.supabase_key)}")
            
            if result.returncode != 0:
                # Log the actual error so it appears in Railway logs
                log_step(f"SCRIPT FAILED - stderr: {result.stderr[-1500:] if result.stderr else 'none'}")
                log_step(f"SCRIPT FAILED - stdout: {result.stdout[-500:] if result.stdout else 'none'}")
                return {
                    "error": f"Jump cut processing failed (exit code {result.returncode})",
                    "stdout": result.stdout[-2000:] if result.stdout else None,
                    "stderr": result.stderr[-2000:] if result.stderr else None,
                }
            
            if not os.path.exists(jump_cut_output):
                log_step(f"ERROR: Output file not found at {jump_cut_output}")
                
                # Check for specific errors in output
                error_detail = "Unknown - check stdout/stderr for details"
                if result.stdout:
                    if "missing" in result.stdout.lower():
                        error_detail = "Segment files were not created - FFmpeg encoding failed"
                    elif "concat failed" in result.stdout.lower():
                        error_detail = "Final concatenation step failed"
                    elif "❌" in result.stdout:
                        # Extract error messages from stdout
                        errors = [line for line in result.stdout.split('\n') if '❌' in line]
                        if errors:
                            error_detail = "; ".join(errors[:3])
                
                return {
                    "error": f"Jump cut output file not created: {error_detail}",
                    "stdout": result.stdout[-2000:] if result.stdout else None,
                    "stderr": result.stderr[-2000:] if result.stderr else None,
                }
            
            # Verify the output file has content
            output_size = os.path.getsize(jump_cut_output)
            log_step(f"DEBUG: jump_cut output file size: {output_size / 1024 / 1024:.1f} MB")
            
            if output_size < 1000:  # Less than 1KB is suspicious
                log_step(f"ERROR: Output file too small ({output_size} bytes)")
                return {
                    "error": f"Jump cut output file too small ({output_size} bytes)",
                    "stdout": result.stdout[-2000:] if result.stdout else None,
                    "stderr": result.stderr[-2000:] if result.stderr else None,
                }
            
            # Check if restart detection was actually applied
            if request.detect_restarts and result.stdout and "restart" in result.stdout.lower():
                features_applied["detect_restarts"] = True
            
            # Parse number of speech segments from output to calculate silences removed
            silences_removed = 0
            if result.stdout:
                # Look for "Found X speech segments" in output
                import re as regex
                match = regex.search(r'Found (\d+) speech segments', result.stdout)
                if match:
                    num_segments = int(match.group(1))
                    # Silences removed = gaps between segments = segments - 1
                    silences_removed = max(0, num_segments - 1)
                    log_step(f"Detected {num_segments} speech segments, {silences_removed} silences removed")
            
            current_output = jump_cut_output
            
            # ============================================
            # IMMEDIATE UPLOAD: Save processed video to Supabase right away
            # This ensures we don't lose the video if the service restarts
            # ============================================
            log_step("DEBUG: Starting upload section...", include_memory=True)
            log_step(f"DEBUG: supabase_url={request.supabase_url[:50] if request.supabase_url else 'None'}...")
            log_step(f"DEBUG: supabase_key={'set' if request.supabase_key else 'NOT SET'}")
            log_step(f"DEBUG: output_bucket={request.output_bucket}, output_folder={request.output_folder}")
            
            interim_url = None
            if request.supabase_url and request.supabase_key:
                log_step("Uploading processed video to Supabase (interim save)...")
                try:
                    # Get file size first
                    interim_size = os.path.getsize(current_output)
                    log_step(f"Interim file size: {interim_size / 1024 / 1024:.1f} MB")
                    
                    # Generate unique filename
                    timestamp = int(time.time() * 1000)
                    interim_filename = f"{request.title or 'video'}_{timestamp}_edited.mp4"
                    interim_filename = re.sub(r'[^a-zA-Z0-9_.-]', '_', interim_filename)
                    storage_path = f"{request.output_folder}/{interim_filename}"
                    
                    # Upload using Supabase REST API
                    upload_url = f"{request.supabase_url}/storage/v1/object/{request.output_bucket}/{storage_path}"
                    
                    with open(current_output, 'rb') as f:
                        upload_response = requests.post(
                            upload_url,
                            headers={
                                "Authorization": f"Bearer {request.supabase_key}",
                                "Content-Type": "video/mp4",
                            },
                            data=f,
                            timeout=300,
                        )
                    
                    log_step(f"DEBUG: Upload response status: {upload_response.status_code}")
                    
                    if upload_response.status_code in [200, 201]:
                        interim_url = f"{request.supabase_url}/storage/v1/object/public/{request.output_bucket}/{storage_path}"
                        log_step(f"Interim upload SUCCESS: {interim_url}")
                    elif upload_response.status_code == 400:
                        log_step(f"Interim upload FAILED (400 Bad Request): {upload_response.text[:500]}")
                        log_step("💡 This usually means the bucket doesn't exist or the path is invalid")
                    elif upload_response.status_code == 401:
                        log_step(f"Interim upload FAILED (401 Unauthorized): Invalid or expired Supabase key")
                    elif upload_response.status_code == 403:
                        log_step(f"Interim upload FAILED (403 Forbidden): Check RLS policies on storage bucket")
                    elif upload_response.status_code == 413:
                        log_step(f"Interim upload FAILED (413 Payload Too Large): Video exceeds Supabase limits")
                    else:
                        log_step(f"Interim upload FAILED: {upload_response.status_code} - {upload_response.text[:500]}")
                except requests.exceptions.Timeout:
                    log_step(f"Interim upload TIMEOUT: Upload took too long (5 min limit)")
                except requests.exceptions.ConnectionError as conn_err:
                    log_step(f"Interim upload CONNECTION ERROR: {str(conn_err)[:200]}")
                except Exception as upload_err:
                    import traceback
                    log_step(f"Interim upload ERROR: {str(upload_err)}")
                    log_step(f"Traceback: {traceback.format_exc()[:500]}")
            else:
                log_step("⚠️ Skipping Supabase upload - credentials not provided")
                log_step(f"   supabase_url: {'set' if request.supabase_url else 'NOT SET'}")
                log_step(f"   supabase_key: {'set' if request.supabase_key else 'NOT SET'}")
            
            # ============================================
            # STEP 2: Run insert_3d_transition.py (if enabled)
            # ============================================
            if request.add_swivel:
                log_step("Running insert_3d_transition.py...")
                start_time = time.time()
                
                swivel_script = os.path.join(SCRIPTS_DIR, "insert_3d_transition.py")
                swivel_output = os.path.join(tmpdir, "swivel_output.mp4")
                
                cmd = [
                    "python", swivel_script,
                    current_output, swivel_output,
                    "--insert-at", "3",
                    "--duration", "5",
                ]
                
                if bg_image_local:
                    cmd.extend(["--bg-image", bg_image_local])
                
                result = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
                
                processing_logs.append(f"swivel stdout: {result.stdout[-500:] if result.stdout else 'none'}")
                processing_logs.append(f"swivel stderr: {result.stderr[-500:] if result.stderr else 'none'}")
                
                elapsed = time.time() - start_time
                log_step(f"swivel completed in {elapsed:.1f}s (exit code: {result.returncode})")
                
                if result.returncode == 0 and os.path.exists(swivel_output):
                    current_output = swivel_output
                    features_applied["add_swivel"] = True
                else:
                    log_step(f"Swivel failed, continuing without it: {result.stderr[:200] if result.stderr else 'unknown error'}")
            
            # Copy final output
            shutil.copy(current_output, final_output)
            
            # Get final duration
            probe_result = subprocess.run(
                ["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "json", final_output],
                capture_output=True, text=True, timeout=30
            )
            final_duration = float(json.loads(probe_result.stdout)["format"]["duration"])
            log_step(f"Final duration: {final_duration:.1f}s")
            
            # Get file size
            final_size = os.path.getsize(final_output)
            log_step(f"Final size: {final_size / 1024 / 1024:.1f} MB")
            
            # ============================================
            # STEP 3: Upload final video to Supabase Storage
            # (Only if swivel was applied and changed the output)
            # ============================================
            output_url = interim_url  # Start with interim URL as fallback
            
            # Only re-upload if we applied swivel (output changed from interim)
            if request.add_swivel and features_applied.get("add_swivel") and request.supabase_url and request.supabase_key:
                log_step("Uploading final video (with swivel) to Supabase Storage...")
                try:
                    # Generate unique filename for final version
                    timestamp = int(time.time() * 1000)
                    filename = f"{request.title or 'video'}_{timestamp}_final.mp4"
                    filename = re.sub(r'[^a-zA-Z0-9_.-]', '_', filename)
                    storage_path = f"{request.output_folder}/{filename}"
                    
                    # Upload using Supabase REST API
                    upload_url = f"{request.supabase_url}/storage/v1/object/{request.output_bucket}/{storage_path}"
                    
                    with open(final_output, 'rb') as f:
                        upload_response = requests.post(
                            upload_url,
                            headers={
                                "Authorization": f"Bearer {request.supabase_key}",
                                "Content-Type": "video/mp4",
                            },
                            data=f,
                            timeout=300,
                        )
                    
                    if upload_response.status_code in [200, 201]:
                        output_url = f"{request.supabase_url}/storage/v1/object/public/{request.output_bucket}/{storage_path}"
                        log_step(f"Final upload SUCCESS: {output_url}")
                    else:
                        log_step(f"Final upload failed, using interim: {upload_response.status_code}")
                        # Keep using interim_url
                except Exception as final_upload_err:
                    log_step(f"Final upload error, using interim: {str(final_upload_err)}")
                    # Keep using interim_url
            
            # If no URL at all, return base64 as last resort fallback
            video_base64 = None
            if not output_url:
                log_step("No Supabase URL available, checking if we should return base64...", include_memory=True)
                # Check file size - base64 encoding doubles size, so limit to ~50MB video (100MB base64)
                file_size_mb = final_size / 1024 / 1024
                if file_size_mb > 50:
                    log_step(f"⚠️ Video too large for base64 ({file_size_mb:.1f}MB). Skipping base64 encoding.")
                    log_step("⚠️ Please check Supabase credentials are configured correctly.")
                else:
                    log_step(f"Encoding {file_size_mb:.1f}MB video to base64...", include_memory=True)
                    import base64
                    with open(final_output, 'rb') as f:
                        video_base64 = base64.b64encode(f.read()).decode()
                    gc.collect()  # Free memory after base64 encoding
                    log_step(f"Base64 encoding complete: {len(video_base64) / 1024 / 1024:.1f}MB", include_memory=True)
            else:
                log_step(f"Using Supabase URL: {output_url}")
            
            time_saved = original_duration - final_duration
            log_step(f"Complete! Time saved: {time_saved:.1f}s ({time_saved/original_duration*100:.0f}%)")
            log_step(f"DEBUG: Returning response with output_url={bool(output_url)}, video_base64={bool(video_base64)}")
            
            response_data = {
                "success": True,
                "output_url": output_url,
                "video_base64": video_base64,  # Fallback if no Supabase
                "original_duration": round(original_duration, 2),
                "final_duration": round(final_duration, 2),
                "time_saved": round(time_saved, 2),
                "silences_removed": silences_removed,
                "file_size_mb": round(final_size / 1024 / 1024, 2),
                "features_applied": features_applied,
                "processing_logs": processing_logs if os.environ.get("DEBUG") else None,
            }
            
            # Log response size before returning
            response_size_estimate = len(str(response_data))
            if video_base64:
                response_size_estimate = len(video_base64)
            log_step(f"DEBUG: Response size estimate: {response_size_estimate / 1024 / 1024:.1f}MB")
            log_step(f"=== VIDEO EDIT ENDPOINT COMPLETE ===")
            
            return response_data
            
    except subprocess.TimeoutExpired as timeout_err:
        log_step(f"TIMEOUT ERROR: {str(timeout_err)}")
        return {"error": "Processing timed out (10 minute limit). Try a shorter video."}
    except requests.Timeout as req_timeout:
        log_step(f"REQUEST TIMEOUT ERROR: {str(req_timeout)}")
        return {"error": "Download/upload timed out. Check your network connection."}
    except Exception as e:
        import traceback
        error_traceback = traceback.format_exc()
        log_step(f"UNHANDLED ERROR: {str(e)}")
        log_step(f"TRACEBACK: {error_traceback[:1000]}")
        return {
            "error": str(e),
            "traceback": error_traceback,
        }


# ============================================
# VIDEO COMPOSE (Editor Timeline Export)
# ============================================

class CompositionClip(BaseModel):
    id: str
    type: str  # "video" | "audio" | "caption" | "text"
    trackId: str
    startTime: float
    duration: float
    sourceUrl: Optional[str] = None
    sourceStart: Optional[float] = 0
    sourceEnd: Optional[float] = 0
    volume: Optional[float] = 1.0
    speed: Optional[float] = 1.0
    text: Optional[str] = None
    layoutSlot: Optional[str] = "full"
    filters: Optional[list[str]] = None
    captionStyle: Optional[dict] = None
    captionWords: Optional[list[dict]] = None
    cropX: Optional[float] = 0
    cropY: Optional[float] = 0
    cropScale: Optional[float] = 1.0

class CompositionTrack(BaseModel):
    id: str
    type: str  # "video" | "audio" | "caption"
    clips: list[CompositionClip]
    muted: Optional[bool] = False
    volume: Optional[float] = 1.0
    label: Optional[str] = None

class CompositionElement(BaseModel):
    id: str
    clipId: str
    type: str = "text"
    x: float = 0
    y: float = 0
    width: float = 100
    height: float = 20
    rotation: float = 0
    text: Optional[str] = None
    style: Optional[dict] = None

class CompositionPayload(BaseModel):
    id: str
    aspectRatio: str = "16:9"
    tracks: list[CompositionTrack]
    elements: Optional[list[CompositionElement]] = None
    duration: float

class VideoComposeRequest(BaseModel):
    composition: CompositionPayload
    supabase_url: Optional[str] = None
    supabase_key: Optional[str] = None
    output_bucket: str = "videos"
    output_folder: str = "composed"
    export_settings: Optional[dict] = None


def _canvas_size(ar: str) -> tuple[int, int]:
    """Return (width, height) for an aspect ratio string."""
    mapping = {
        "16:9": (1920, 1080), "9:16": (1080, 1920), "1:1": (1080, 1080),
        "4:3": (1440, 1080), "3:4": (1080, 1440), "2:1": (2160, 1080),
    }
    return mapping.get(ar, (1920, 1080))


def _slot_region(slot: str, cw: int, ch: int) -> tuple[int, int, int, int]:
    """Return (x, y, w, h) for a layout slot on a canvas of size cw x ch."""
    half_h = ch // 2
    half_w = cw // 2
    regions = {
        "full": (0, 0, cw, ch),
        "top": (0, 0, cw, half_h),
        "bottom": (0, half_h, cw, half_h),
        "left": (0, 0, half_w, ch),
        "right": (half_w, 0, half_w, ch),
    }
    return regions.get(slot, (0, 0, cw, ch))


def _escape_drawtext(s: str) -> str:
    """Escape a string for FFmpeg drawtext filter."""
    return s.replace("\\", "\\\\").replace(":", "\\:").replace("'", "\\'").replace("%", "%%")


def _pick_font(text: str, bold: bool = False) -> str:
    """Pick the best available font for the given text (CJK-aware)."""
    has_cjk = any('\u4e00' <= c <= '\u9fff' or '\u3040' <= c <= '\u30ff' or '\uac00' <= c <= '\ud7af' for c in text)
    if has_cjk:
        return "/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc" if bold else "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
    return "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf" if bold else "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"


@app.post("/video-compose")
async def video_compose_endpoint(request: VideoComposeRequest, _: bool = Depends(verify_api_key)):
    """
    Compose a final video from a Composition JSON (editor timeline export).

    Supports multiple video tracks with layout slots (split/PiP), text
    overlays via drawtext, speed changes, volume, and aspect ratio scaling.
    """
    import subprocess
    import tempfile
    import uuid

    composition = request.composition
    cw, ch = _canvas_size(composition.aspectRatio)

    # Apply export_settings resolution if provided
    es = request.export_settings or {}
    if es.get("width") and es.get("height"):
        cw, ch = int(es["width"]), int(es["height"])
    crf = str(es.get("crf", 23))

    sb_url = request.supabase_url or os.getenv("SUPABASE_URL") or os.getenv("NEXT_PUBLIC_SUPABASE_URL")
    sb_key = request.supabase_key or os.getenv("SUPABASE_SERVICE_ROLE_KEY")

    work_dir = tempfile.mkdtemp(prefix="compose_")
    output_path = os.path.join(work_dir, "output.mp4")

    try:
        video_tracks = [t for t in composition.tracks if t.type == "video" and t.clips]
        audio_tracks = [t for t in composition.tracks if t.type == "audio" and t.clips and not t.muted]
        if not video_tracks:
            raise HTTPException(status_code=400, detail="No video tracks found")

        # Calculate actual duration from clip end times (not timeline length)
        actual_duration = 0.0
        for t in composition.tracks:
            for c in t.clips:
                end = c.startTime + c.duration
                if end > actual_duration:
                    actual_duration = end
        if actual_duration <= 0:
            actual_duration = composition.duration

        source_cache: dict[str, str] = {}

        def download_source(url: str) -> str:
            if url in source_cache:
                return source_cache[url]
            path = os.path.join(work_dir, f"src_{len(source_cache)}.mp4")
            resp = safe_media_get(url, timeout=180, stream=True)
            resp.raise_for_status()
            with open(path, "wb") as f:
                for chunk in resp.iter_content(chunk_size=8192):
                    f.write(chunk)
            source_cache[url] = path
            return path

        # ── Step 1: Trim each clip → contain+pad into slot → zoom/crop ──
        clip_segments: dict[str, str] = {}  # clip.id -> segment path
        track_muted: dict[str, bool] = {}  # track.id -> is muted

        seg_idx = 0
        for track in video_tracks:
            is_muted = bool(track.muted)
            track_muted[track.id] = is_muted

            slot = "full"
            for c in track.clips:
                if c.layoutSlot and c.layoutSlot != "full":
                    slot = c.layoutSlot
                    break
            _, _, sw, sh = _slot_region(slot, cw, ch)

            for clip in track.clips:
                if not clip.sourceUrl:
                    continue
                local_src = download_source(clip.sourceUrl)
                seg_path = os.path.join(work_dir, f"seg_{seg_idx:04d}.mp4")
                seg_idx += 1

                cmd = ["ffmpeg", "-y", "-ss", str(clip.sourceStart or 0), "-to", str(clip.sourceEnd or clip.duration), "-i", local_src]
                vf = []
                af = []
                speed = clip.speed or 1.0
                if speed != 1.0:
                    vf.append(f"setpts={1/speed}*PTS")
                    af.append(f"atempo={speed}")

                # Contain+pad into the layout slot size (replicates CSS object-fit: contain)
                vf.append(f"scale={sw}:{sh}:force_original_aspect_ratio=decrease,pad={sw}:{sh}:(ow-iw)/2:(oh-ih)/2:black")

                # Apply zoom/crop on top (replicates CSS transform: scale(S) translate(Px%, Py%))
                S = clip.cropScale or 1.0
                Px = clip.cropX or 0
                Py = clip.cropY or 0
                if S > 1.0 or Px != 0 or Py != 0:
                    zs = max(S, 1.0)
                    vf.append(f"scale=iw*{zs}:ih*{zs}")
                    cx = int(sw * ((zs - 1) / 2 - zs * Px / 100))
                    cy = int(sh * ((zs - 1) / 2 - zs * Py / 100))
                    cx = max(0, min(cx, int(sw * zs - sw)))
                    cy = max(0, min(cy, int(sh * zs - sh)))
                    vf.append(f"crop={sw}:{sh}:{cx}:{cy}")

                # Respect volume: 0 or muted track = strip audio
                vol = clip.volume if clip.volume is not None else 1.0
                strip_audio = is_muted or vol == 0
                if not strip_audio and vol != 1.0:
                    af.append(f"volume={vol}")

                if vf:
                    cmd += ["-vf", ",".join(vf)]
                if strip_audio:
                    cmd += ["-an"]
                elif af:
                    cmd += ["-af", ",".join(af)]
                cmd += ["-c:v", "libx264", "-preset", "fast", "-crf", crf]
                if not strip_audio:
                    cmd += ["-c:a", "aac", "-b:a", "128k"]
                cmd += [seg_path]
                subprocess.run(cmd, check=True, capture_output=True, timeout=600)
                clip_segments[clip.id] = seg_path

        # ── Step 2: Concatenate clips per track (with xfade transitions) ──
        XFADE_MAP = {
            "fade": "fade", "crossfade": "fade",
            "slide-up": "slideup", "slide-down": "slidedown",
            "slide-left": "slideleft", "slide-right": "slideright",
            "wipe-up": "wipeup", "wipe-down": "wipedown",
            "wipe-left": "wipeleft", "wipe-right": "wiperight",
            "swivel-3d": "smoothleft", "clockwipe": "radial",
        }

        def _parse_clip_transition(clip_obj: CompositionClip):
            """Extract transition info from clip filters."""
            if not clip_obj.filters:
                return None
            t_type = None
            t_dur = 0.5
            t_edge = "start"
            for f in clip_obj.filters:
                if f.startswith("transition:") and not f.startswith("transition-duration:") and not f.startswith("transition-edge:"):
                    t_type = f.split(":")[1]
                elif f.startswith("transition-duration:"):
                    t_dur = float(f.split(":")[1])
                elif f.startswith("transition-edge:"):
                    t_edge = f.split(":")[1]
            if not t_type or t_type == "none":
                return None
            return {"type": t_type, "duration": t_dur, "edge": t_edge}

        def _get_segment_duration(seg_path: str) -> float:
            """Get actual duration of a segment via ffprobe."""
            result = subprocess.run(
                ["ffprobe", "-v", "quiet", "-show_entries", "format=duration",
                 "-of", "default=noprint_wrappers=1:nokey=1", seg_path],
                capture_output=True, text=True, timeout=30,
            )
            try:
                return float(result.stdout.strip())
            except (ValueError, AttributeError):
                return 0.0

        track_videos: list[tuple[str, str]] = []  # (path, layout_slot)

        for track in video_tracks:
            clips_with_segs = [(c, clip_segments[c.id]) for c in sorted(track.clips, key=lambda c: c.startTime) if c.id in clip_segments]
            if not clips_with_segs:
                continue

            slot = "full"
            for c, _ in clips_with_segs:
                if c.layoutSlot and c.layoutSlot != "full":
                    slot = c.layoutSlot
                    break

            if len(clips_with_segs) == 1:
                clip_obj, seg = clips_with_segs[0]
                trans = _parse_clip_transition(clip_obj)
                if trans and trans["type"] in ("fade", "crossfade"):
                    faded = os.path.join(work_dir, f"faded_{len(track_videos)}.mp4")
                    seg_dur = _get_segment_duration(seg)
                    fade_vf = []
                    if trans["edge"] == "start":
                        fade_vf.append(f"fade=t=in:st=0:d={trans['duration']}")
                    else:
                        st = max(0, seg_dur - trans["duration"])
                        fade_vf.append(f"fade=t=out:st={st}:d={trans['duration']}")
                    subprocess.run(
                        ["ffmpeg", "-y", "-i", seg, "-vf", ",".join(fade_vf),
                         "-c:v", "libx264", "-preset", "fast", "-crf", crf,
                         "-c:a", "copy", faded],
                        check=True, capture_output=True, timeout=600,
                    )
                    track_path = faded
                else:
                    track_path = seg
            else:
                # Check if any clip has a transition
                has_transitions = any(_parse_clip_transition(c) for c, _ in clips_with_segs)

                if not has_transitions:
                    concat_file = os.path.join(work_dir, f"concat_track_{len(track_videos)}.txt")
                    with open(concat_file, "w") as f:
                        for _, seg in clips_with_segs:
                            f.write(f"file '{seg}'\n")
                    track_path = os.path.join(work_dir, f"track_{len(track_videos)}.mp4")
                    subprocess.run(
                        ["ffmpeg", "-y", "-f", "concat", "-safe", "0", "-i", concat_file, "-c", "copy", track_path],
                        check=True, capture_output=True, timeout=600,
                    )
                else:
                    # Use xfade filter_complex for transitions between clips
                    seg_durations = [_get_segment_duration(seg) for _, seg in clips_with_segs]
                    inputs_cmd: list[str] = []
                    for _, seg in clips_with_segs:
                        inputs_cmd += ["-i", seg]

                    v_filters = []
                    a_filters = []
                    running_offset = 0.0
                    n_clips = len(clips_with_segs)

                    for idx in range(1, n_clips):
                        clip_obj, _ = clips_with_segs[idx]
                        trans = _parse_clip_transition(clip_obj)
                        if trans:
                            xfade_type = XFADE_MAP.get(trans["type"], "fade")
                            td = max(trans["duration"], 0.04)
                        else:
                            xfade_type = "fade"
                            td = 0.04

                        prev_label = f"[v{idx-1}]" if idx > 1 else "[0:v]"
                        curr_input = f"[{idx}:v]"
                        out_label = f"[v{idx}]"

                        offset = running_offset + seg_durations[idx - 1] - td
                        if offset < 0:
                            offset = 0
                        v_filters.append(
                            f"{prev_label}{curr_input}xfade=transition={xfade_type}:duration={td}:offset={offset:.3f}{out_label}"
                        )

                        prev_a_label = f"[a{idx-1}]" if idx > 1 else "[0:a]"
                        curr_a_input = f"[{idx}:a]"
                        out_a_label = f"[a{idx}]"
                        a_filters.append(
                            f"{prev_a_label}{curr_a_input}acrossfade=d={td}:c1=tri:c2=tri{out_a_label}"
                        )

                        running_offset = offset

                    final_v = f"[v{n_clips-1}]"
                    final_a = f"[a{n_clips-1}]"

                    # Apply fade-in on first clip if it has a transition
                    first_trans = _parse_clip_transition(clips_with_segs[0][0])
                    pre_filters = []
                    if first_trans and first_trans["edge"] == "start" and first_trans["type"] in ("fade", "crossfade"):
                        pre_filters.append(f"[0:v]fade=t=in:st=0:d={first_trans['duration']}[v0fade]")
                        v_filters[0] = v_filters[0].replace("[0:v]", "[v0fade]")

                    all_filters = pre_filters + v_filters + a_filters

                    track_path = os.path.join(work_dir, f"track_{len(track_videos)}.mp4")
                    cmd = ["ffmpeg", "-y"] + inputs_cmd + [
                        "-filter_complex", ";".join(all_filters),
                        "-map", final_v, "-map", final_a,
                        "-c:v", "libx264", "-preset", "fast", "-crf", crf,
                        "-c:a", "aac", "-b:a", "128k",
                        track_path,
                    ]
                    subprocess.run(cmd, check=True, capture_output=True, timeout=600)

            track_videos.append((track_path, slot))

        # ── Step 3: Composite tracks onto canvas ─────────────────────────
        # Clips are already at their slot size (contain+pad+zoom applied in step 1).
        if len(track_videos) == 1 and track_videos[0][1] == "full":
            composite_path = track_videos[0][0]
        else:
            # Ensure each track has an audio stream (add silent if missing)
            normed_tracks: list[tuple[str, str]] = []
            for ti, (vpath, slot) in enumerate(track_videos):
                normed = os.path.join(work_dir, f"normed_{ti}.mp4")
                subprocess.run(
                    ["ffmpeg", "-y", "-i", vpath,
                     "-f", "lavfi", "-i", "anullsrc=r=44100:cl=stereo",
                     "-c:v", "copy", "-c:a", "aac", "-b:a", "128k",
                     "-map", "0:v:0", "-map", "0:a?", "-map", "1:a",
                     "-shortest", normed],
                    check=True, capture_output=True, timeout=600,
                )
                normed_tracks.append((normed, slot))

            # Build overlay filter_complex
            inputs_cmd: list[str] = []
            inputs_cmd += ["-f", "lavfi", "-i", f"color=black:s={cw}x{ch}:d={actual_duration}:r=30"]
            for normed, _ in normed_tracks:
                inputs_cmd += ["-i", normed]

            filter_parts = []
            overlay_chain = "[0:v]"
            for i, (_, slot) in enumerate(normed_tracks):
                inp = i + 1
                sx, sy, _, _ = _slot_region(slot, cw, ch)
                out = f"[ov{inp}]"
                filter_parts.append(f"{overlay_chain}[{inp}:v]overlay={sx}:{sy}:eof_action=pass{out}")
                overlay_chain = out

            # Mix audio from all track inputs (skip input 0 = black canvas)
            n = len(normed_tracks)
            audio_refs = "".join(f"[{i+1}:a]" for i in range(n))
            filter_parts.append(f"{audio_refs}amix=inputs={n}:duration=longest[aout]")

            composite_path = os.path.join(work_dir, "composite.mp4")
            cmd = ["ffmpeg", "-y"] + inputs_cmd + [
                "-filter_complex", ";".join(filter_parts),
                "-map", overlay_chain,
                "-map", "[aout]",
                "-c:v", "libx264", "-preset", "fast", "-crf", crf,
                "-c:a", "aac", "-b:a", "128k",
                composite_path,
            ]
            subprocess.run(cmd, check=True, capture_output=True, timeout=600)

        # ── Step 4: Add text overlays ────────────────────────────────────
        from editor_caption_rendering import write_native_overlays

        native_overlay_path = os.path.join(work_dir, "native_overlays.ass")
        native_overlay_ids = write_native_overlays(
            composition.model_dump(), native_overlay_path, _canvas_size(composition.aspectRatio)
        )
        elements = composition.elements or []
        text_elements = [e for e in elements if e.type == "text" and e.text and e.clipId not in native_overlay_ids]

        # Only use text/caption clips as fallback if no canvas element covers them
        element_clip_ids = {e.clipId for e in text_elements} | native_overlay_ids
        for track in composition.tracks:
            if track.type in ("text", "caption"):
                for clip in track.clips:
                    if clip.text and clip.id not in element_clip_ids:
                        text_elements.append(CompositionElement(
                            id=clip.id, clipId=clip.id, type="text",
                            x=10, y=80, width=80, height=15,
                            text=clip.text,
                            style={"fontSize": 64, "color": "#ffffff", "align": "center"},
                        ))

        if text_elements or native_overlay_ids:
            drawtext_filters = []
            for el in text_elements:
                # Literal text files avoid treating user punctuation as FFmpeg
                # expression syntax (including apostrophes, colons and %).
                text_path = os.path.join(work_dir, f"overlay_text_{len(drawtext_filters)}.txt")
                with open(text_path, "w", encoding="utf-8") as text_file:
                    text_file.write(el.text or "")
                s = el.style or {}
                raw_size = s.get("fontSize", 48)
                font_size = int(raw_size * ch / 1080)
                color = s.get("color", "white")
                align = s.get("align", "center")
                weight = s.get("fontWeight", 400)

                # Position: element x/y are percentages of canvas
                px = int(el.x * cw / 100)
                py = int(el.y * ch / 100)
                ew = int(el.width * cw / 100)

                if align == "center":
                    x_expr = f"{px}+({ew}-tw)/2"
                elif align == "right":
                    x_expr = f"{px}+{ew}-tw"
                else:
                    x_expr = str(px)

                # Find timing from linked clip
                enable = ""
                for track in composition.tracks:
                    for clip in track.clips:
                        if clip.id == el.clipId:
                            t_start = clip.startTime
                            t_end = clip.startTime + clip.duration
                            enable = f":enable='between(t,{t_start},{t_end})'"
                            break

                font_path = _pick_font(el.text or "", bold=(weight >= 700))
                font_opt = f":fontfile={font_path}"

                dt = (
                    f"drawtext=textfile='{text_path}':expansion=none"
                    f":fontsize={font_size}:fontcolor={color}"
                    f":x={x_expr}:y={py}{enable}{font_opt}"
                    f":shadowcolor=black@0.6:shadowx=2:shadowy=2"
                )
                fill = s.get("fillColor")
                if fill:
                    dt += f":box=1:boxcolor={fill}@0.7:boxborderw=8"
                drawtext_filters.append(dt)

            if native_overlay_ids:
                drawtext_filters.append(f"subtitles=filename='{native_overlay_path}'")

            text_output = os.path.join(work_dir, "with_text.mp4")
            subprocess.run(
                ["ffmpeg", "-y", "-i", composite_path,
                 "-vf", ",".join(drawtext_filters),
                 "-c:v", "libx264", "-preset", "fast", "-crf", crf,
                 "-c:a", "copy", text_output],
                check=True, capture_output=True, timeout=600,
            )
            output_path = text_output
        else:
            output_path = composite_path

        # ── Step 5: Mix in separate audio tracks ─────────────────────────
        if audio_tracks:
            audio_segs: list[str] = []
            for at in audio_tracks:
                for ai, aclip in enumerate(sorted(at.clips, key=lambda c: c.startTime)):
                    if not aclip.sourceUrl:
                        continue
                    a_src = download_source(aclip.sourceUrl)
                    a_seg = os.path.join(work_dir, f"audio_{len(audio_segs)}.aac")
                    a_cmd = ["ffmpeg", "-y", "-ss", str(aclip.sourceStart or 0), "-to", str(aclip.sourceEnd or aclip.duration), "-i", a_src]
                    a_af = []
                    a_speed = aclip.speed or 1.0
                    if a_speed != 1.0:
                        a_af.append(f"atempo={a_speed}")
                    a_vol = aclip.volume if aclip.volume is not None else 1.0
                    a_trk_vol = at.volume if at.volume is not None else 1.0
                    combined_vol = a_vol * a_trk_vol
                    if combined_vol != 1.0 and combined_vol > 0:
                        a_af.append(f"volume={combined_vol}")
                    if combined_vol == 0:
                        continue
                    # Delay audio to match its timeline position
                    delay_ms = int(aclip.startTime * 1000)
                    if delay_ms > 0:
                        a_af.append(f"adelay={delay_ms}|{delay_ms}")
                    if a_af:
                        a_cmd += ["-af", ",".join(a_af)]
                    a_cmd += ["-vn", "-c:a", "aac", "-b:a", "128k", a_seg]
                    subprocess.run(a_cmd, check=True, capture_output=True, timeout=300)
                    audio_segs.append(a_seg)

            if audio_segs:
                mixed_output = os.path.join(work_dir, "with_audio.mp4")
                mix_inputs = ["-i", output_path]
                for aseg in audio_segs:
                    mix_inputs += ["-i", aseg]
                n_audio = len(audio_segs) + 1  # video's audio + extra audio tracks
                audio_refs = "".join(f"[{i}:a]" for i in range(n_audio))
                mix_cmd = ["ffmpeg", "-y"] + mix_inputs + [
                    "-filter_complex", f"{audio_refs}amix=inputs={n_audio}:duration=first:dropout_transition=0[aout]",
                    "-map", "0:v", "-map", "[aout]",
                    "-c:v", "copy", "-c:a", "aac", "-b:a", "128k",
                    mixed_output,
                ]
                subprocess.run(mix_cmd, check=True, capture_output=True, timeout=600)
                output_path = mixed_output

        # ── Step 6: Upload to Supabase Storage ───────────────────────────
        if sb_url and sb_key:
            file_name = f"{request.output_folder}/{composition.id}_{uuid.uuid4().hex[:8]}.mp4"
            file_size_mb = os.path.getsize(output_path) / (1024 * 1024)

            with open(output_path, "rb") as f:
                upload_resp = requests.post(
                    f"{sb_url}/storage/v1/object/{request.output_bucket}/{file_name}",
                    headers={
                        "Authorization": f"Bearer {sb_key}",
                        "Content-Type": "video/mp4",
                        "x-upsert": "true",
                    },
                    data=f,
                    timeout=300,
                )

            if upload_resp.status_code not in (200, 201):
                raise Exception(f"Supabase upload failed ({upload_resp.status_code}): {upload_resp.text[:300]}")

            public_url = f"{sb_url}/storage/v1/object/public/{request.output_bucket}/{file_name}"

            return {
                "output_url": public_url,
                "duration": actual_duration,
                "file_size_mb": round(file_size_mb, 2),
            }
        else:
            return {
                "error": "Supabase credentials not configured",
                "local_path": output_path,
            }

    except subprocess.TimeoutExpired:
        raise HTTPException(status_code=504, detail="FFmpeg processing timed out")
    except subprocess.CalledProcessError as e:
        stderr = e.stderr.decode() if e.stderr else str(e)
        # Strip the FFmpeg version banner to show the actual error
        lines = stderr.split("\n")
        err_lines = [l for l in lines if not l.startswith("  ") and "Copyright" not in l and "configuration:" not in l and "built with" not in l and "lib" not in l.lstrip()]
        err_msg = "\n".join(err_lines[-15:]) if err_lines else stderr[-800:]
        raise HTTPException(status_code=500, detail=f"FFmpeg error: {err_msg[:800]}")
    except Exception as e:
        import traceback
        raise HTTPException(status_code=500, detail=f"{str(e)}\n{traceback.format_exc()[:500]}")
    finally:
        import shutil
        if os.path.exists(work_dir) and work_dir.startswith(tempfile.gettempdir()):
            shutil.rmtree(work_dir, ignore_errors=True)


# ============================================
# MAIN
# ============================================

if __name__ == "__main__":
    import uvicorn
    
    port = int(os.getenv("PORT", "8000"))
    uvicorn.run(
        "main:app",
        host="0.0.0.0",
        port=port,
        reload=os.getenv("ENV", "development") == "development",
    )
