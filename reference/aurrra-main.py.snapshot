    style_reference_images: Optional[list[str]] = None
    variations: int = 2
    custom_prompt: Optional[str] = None
    reference_photos: Optional[list[str]] = None
    edit_image_base64: Optional[str] = None
    edit_prompt: Optional[str] = None


class ThumbnailAsyncRequest(BaseModel):
