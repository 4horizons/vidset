def _refund_credits_once(sb_url: str, headers: dict, log_prefix: str,
                         user_id: str | None = None, credit_cost: int | None = None,
                         reference_id: str | None = None):
    """Return credits for a job that failed.

    When the caller knows the reference the charge was tagged with, the refund
    settles that ledger row and later calls become no-ops, so this cannot pay
    out a second time if the web app already refunded the same job. Callers
    that have no reference fall back to a flat refund.
    """
    if reference_id:
        rpc_url = f"{sb_url}/rest/v1/rpc/refund_credits_for_reference"
        payload = {"p_reference_id": reference_id}
        target = f"reference {reference_id}"
    elif user_id and credit_cost and credit_cost > 0:
        rpc_url = f"{sb_url}/rest/v1/rpc/refund_credits"
        payload = {"p_user_id": user_id, "p_amount": credit_cost}
        target = f"user {user_id}"
    else:
        return

    try:
        resp = requests.post(rpc_url, headers=headers, json=payload, timeout=10)
        if resp.status_code in [200, 204]:
            print(f"{log_prefix} Refunded credits for {target}")
        else:
            print(f"{log_prefix} Credit refund failed ({resp.status_code}): {resp.text[:200]}")
    except Exception as e:
        print(f"{log_prefix} Credit refund error: {e}")


def _require_supabase(log_prefix: str, job_ref: str) -> None:
    """Refuse a background job when Supabase is not configured.

    Background tasks report results *and* issue refunds through Supabase, so
    without these variables a job can neither finish nor be refunded from here —
    it would sit non-terminal forever while the user stayed charged. Rejecting
    before the job is accepted hands the failure back to the caller, which
    already marks the row failed and refunds on any non-OK response.
    """
    has_url = os.getenv("SUPABASE_URL") or os.getenv("NEXT_PUBLIC_SUPABASE_URL")
    if has_url and os.getenv("SUPABASE_SERVICE_ROLE_KEY"):
        return

    report_error(f"{log_prefix} Supabase not configured; refusing job {job_ref}")
    raise HTTPException(status_code=503, detail="Service storage is not configured")


async def _run_analysis_and_save(analysis_id: str, video_url: str, video_id: str,
                                  project_id: str, platform: str, caption: str | None,
                                  media_url: str | None = None,
                                  user_id: str | None = None, credit_cost: int | None = None,
                                  credit_reference_id: str | None = None):
    """Background task: run analysis then write results directly to Supabase."""
    sb_url = os.getenv("SUPABASE_URL") or os.getenv("NEXT_PUBLIC_SUPABASE_URL")
    sb_key = os.getenv("SUPABASE_SERVICE_ROLE_KEY")

    if not sb_url or not sb_key:
        # The endpoint rejects these before accepting, so reaching here means the
        # environment changed after the job was queued. Nothing can be recovered
        # from inside the task: the refund would also go through Supabase.
        report_error(
            f"[analyze-async] Supabase credentials missing for analysis {analysis_id}; "
            "job stranded and credits not refunded"
        )
        return

    headers = {
        "apikey": sb_key,
        "Authorization": f"Bearer {sb_key}",
        "Content-Type": "application/json",
        "Prefer": "return=minimal",
    }
    table_url = f"{sb_url}/rest/v1/video_analysis"

    max_retries = 3
    for attempt in range(1, max_retries + 1):
        try:
            print(f"[analyze-async] Attempt {attempt}/{max_retries} for analysis {analysis_id}")
            result = await run_video_analysis(
                url=video_url,
                platform=platform,
                video_id=video_id,
                project_id=project_id,
                caption=caption,
                media_url=media_url,
            )

            update_payload = {
                "status": result.get("status", "failed"),
                "transcript_text": result.get("transcript"),
                "transcript_word_count": result.get("transcript_word_count", 0),
                "content_classification": result.get("content_classification"),
                "summary": result.get("summary"),
                "hook_json": result.get("hook_analysis"),
                "structure_json": result.get("structure_analysis"),
                "style_json": result.get("style_analysis"),
                "cta_json": result.get("cta_analysis"),
                "title_variants": result.get("title_variants", []),
                "key_insights": result.get("key_insights", []),
                "error_message": result.get("error"),
                "completed_at": dt.now().isoformat() if result.get("status") == "completed" else None,
            }

            resp = requests.patch(
                f"{table_url}?id=eq.{analysis_id}",
                headers=headers,
                json=update_payload,
                timeout=15,
            )

            if resp.status_code in [200, 204]:
                print(f"[analyze-async] SUCCESS: analysis {analysis_id} saved (status={result.get('status')})")
                # Refund if the analysis itself failed (e.g. no transcript available)
                if result.get("status") == "failed":
                    _refund_credits_once(
                        sb_url,
                        headers,
                        "[analyze-async]",
                        user_id=user_id,
                        credit_cost=credit_cost,
                        reference_id=credit_reference_id,
                    )
                return
            else:
                print(f"[analyze-async] Supabase update failed ({resp.status_code}): {resp.text[:300]}")

        except Exception as e:
            print(f"[analyze-async] Attempt {attempt} failed for {analysis_id}: {e}")

        if attempt < max_retries:
            import asyncio
            await asyncio.sleep(2 ** attempt)

    # All retries exhausted — mark as failed and refund credits
    try:
        requests.patch(
            f"{table_url}?id=eq.{analysis_id}",
            headers=headers,
            json={"status": "failed", "error_message": "Analysis failed after all retries"},
            timeout=10,
        )
        print(f"[analyze-async] Marked analysis {analysis_id} as failed after {max_retries} retries")
    except Exception as e:
        print(f"[analyze-async] Could not mark {analysis_id} as failed: {e}")

    _refund_credits_once(
        sb_url,
        headers,
        "[analyze-async]",
        user_id=user_id,
        credit_cost=credit_cost,
        reference_id=credit_reference_id,
    )


@app.post("/analyze-async")
async def analyze_video_async_endpoint(
    request: AnalyzeAsyncRequest,
    background_tasks: BackgroundTasks,
    _: bool = Depends(verify_api_key),
):
    """Fire-and-forget video analysis. Results are written directly to Supabase."""
    _require_supabase("[analyze-async]", request.analysis_id)
    background_tasks.add_task(
        _run_analysis_and_save,
        analysis_id=request.analysis_id,
        video_url=request.video_url,
        video_id=request.video_id,
        project_id=request.project_id,
        platform=request.platform,
        caption=request.caption,
        media_url=request.media_url,
        user_id=request.user_id,
        credit_cost=request.credit_cost,
        credit_reference_id=request.credit_reference_id,
    )
    return {"status": "accepted", "analysis_id": request.analysis_id}


