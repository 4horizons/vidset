# Copy to .env OR add keys in the UI (UI keys are kept in server memory).
# Nothing is read from the Aurrra repository.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FAL_KEY=
# Combined API key ID and secret, separated by a colon (not your website login).
HIGGSFIELD_API_KEY=

VISION_PROVIDER=gemini
VISION_MODEL=gemini-2.5-flash
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4.1-mini
IMAGE_MODEL=gpt-image-1.5
VIDEO_EDIT_PROVIDER=higgsfield
FAL_VIDEO_EDIT_MODEL=bytedance/seedance-2.5/reference-to-video
VIDEO_EDIT_MODEL=bytedance/seedance-2.5/video-edit
VIDEO_MODEL=fal-ai/kling-video/o1/image-to-video

