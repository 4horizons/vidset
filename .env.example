# Vidset: copy to .env, add your OWN keys, then run ./run.sh.
# See README.md -> Developer handoff. Never commit a filled .env.
# Recommended pair: OpenAI for understanding/images/voice + Higgsfield for video.
OPENAI_API_KEY=
# Combined API key ID and secret, separated by a colon (not your website login).
HIGGSFIELD_API_KEY=

# Optional alternatives; leave unused keys blank.
FAL_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Defaults for the recommended OpenAI + Higgsfield setup.
# To use fal for source editing, set VIDEO_EDIT_PROVIDER=fal and add FAL_KEY.
VISION_PROVIDER=openai
VISION_MODEL=gpt-4.1-mini
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4.1-mini
IMAGE_MODEL=gpt-image-1.5
VIDEO_EDIT_PROVIDER=higgsfield
FAL_VIDEO_EDIT_MODEL=bytedance/seedance-2.5/reference-to-video
VIDEO_EDIT_MODEL=bytedance/seedance-2.5/video-edit
VIDEO_MODEL=fal-ai/kling-video/o1/image-to-video
